rules_version = '2';

// Signed-in testers may download release APKs. Writes go through the Admin SDK
// in CI — clients must not upload here.
service firebase.storage {
  match /b/{bucket}/o {
    match /releases/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /pandals/{pandalId}/festivals/{festivalId}/{allPaths=**} {
      function isPandalMember() {
        return request.auth != null
          && exists(/databases/(default)/documents/pandals/$(pandalId))
          && (
            get(/databases/(default)/documents/pandals/$(pandalId)).data.ownerId == request.auth.uid
            || request.auth.uid in get(/databases/(default)/documents/pandals/$(pandalId)).data.memberIds
          );
      }
      allow read, write: if isPandalMember();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
