{
  "expo": {
    "name": "Spendly",
    "slug": "spendly",
    "version": "4.3.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "spendly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.example.expensetracker",
      "adaptiveIcon": {
        "backgroundColor": "#071A2B",
        "foregroundImage": "./assets/branding/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "versionCode": 74
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/branding/logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#071A2B"
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#071A2B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Spendly to attach Ganesh receipt and contribution photos.",
          "cameraPermission": "Allow Spendly to photograph Ganesh receipts and contributions."
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_expense": {
              "foregroundImage": "./assets/branding/adaptive-icon.png",
              "backgroundColor": "#071A2B"
            },
            "shortcut_income": {
              "foregroundImage": "./assets/branding/adaptive-icon.png",
              "backgroundColor": "#0B3D2E"
            },
            "shortcut_receipt": {
              "foregroundImage": "./assets/branding/adaptive-icon.png",
              "backgroundColor": "#3D2A0B"
            },
            "shortcut_accounts": {
              "foregroundImage": "./assets/branding/adaptive-icon.png",
              "backgroundColor": "#1A2744"
            }
          },
          "iosActions": [
            {
              "id": "expense.add",
              "title": "Add Expense",
              "subtitle": "Log a new expense",
              "icon": "add",
              "params": { "shortcutId": "expense.add" }
            },
            {
              "id": "income.add",
              "title": "Add Income",
              "subtitle": "Log a new income",
              "icon": "compose",
              "params": { "shortcutId": "income.add" }
            },
            {
              "id": "receipt.add",
              "title": "Scan Receipt",
              "subtitle": "Capture a receipt",
              "icon": "capturePhoto",
              "params": { "shortcutId": "receipt.add" }
            },
            {
              "id": "accounts.open",
              "title": "Accounts",
              "subtitle": "Open accounts",
              "icon": "home",
              "params": { "shortcutId": "accounts.open" }
            }
          ]
        }
      ],
      "./plugins/withReactNativeArchitectures"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a9206a6-87aa-44f7-ac4f-95ec8455efa7"
      }
    }
  }
}
