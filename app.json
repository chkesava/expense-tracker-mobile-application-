{
  "expo": {
    "name": "expense-tracker-mobile",
    "slug": "expense-tracker-mobile",
    "version": "2.1.3",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "expensetrackermobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.example.expensetracker",
      "adaptiveIcon": {
        "backgroundColor": "#0F2F4B",
        "foregroundImage": "./assets/branding/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 36
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F2F4B"
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#0F2F4B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a9206a6-87aa-44f7-ac4f-95ec8455efa7"
      }
    }
  }
}
