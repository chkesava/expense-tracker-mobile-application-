{
  "expo": {
    "name": "Spendly",
    "slug": "spendly",
    "version": "2.3.q",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "spendly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.example.expensetracker",
      "adaptiveIcon": {
        "backgroundColor": "#071A2B",
        "foregroundImage": "./assets/branding/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "versionCode": 45
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#071A2B"
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#071A2B"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Spendly uses the camera to scan receipts and food barcodes. Photos stay on your device and are not uploaded.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spendly accesses photos so you can choose a receipt. Images stay on your device and are not uploaded.",
          "cameraPermission": "Spendly uses the camera to photograph receipts. Photos stay on your device and are not uploaded."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a9206a6-87aa-44f7-ac4f-95ec8455efa7"
      }
    }
  }
}
