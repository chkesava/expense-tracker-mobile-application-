# Public Expo env (safe to embed in the client bundle).
# Copy to `.env` locally. Never put TWELVE_DATA, CRON_SECRET, or service-account JSON here.

# Former VITE_PUBLIC_APP_URL. Three unrelated consumers read this one value:
#   * share links      -> {origin}/split/{slug} and {origin}/payment/{slug}
#   * market data      -> {origin}/api/*        (Netlify functions, Vite repo)
#   * Google Go bridge -> {origin}/mobile-google-auth
# This origin serves the Vite web app. /payment/{slug} is a public route there
# already; /split/{slug} is served by THIS repo's Expo web export on a separate
# Netlify site and proxied in at status 200 (see netlify.toml here, and the
# proxy rules that live in the Vite repo's netlify.toml above its SPA
# catch-all). Do not replace that site with the Expo export — it would take the
# /api/* functions and the Google bridge with it.
EXPO_PUBLIC_APP_URL=https://kesavaexpensetracker.netlify.app

# Optional override for the public Netlify market-function origin. If omitted,
# quote requests use EXPO_PUBLIC_APP_URL plus the /api/* function routes.
# EXPO_PUBLIC_MARKET_API_URL=https://kesavaexpensetracker.netlify.app

# Former VITE_FIREBASE_*
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Former VITE_GEMINI_API_KEY — used to estimate nutrients from natural-language food logs
EXPO_PUBLIC_GEMINI_API_KEY=

# Google OAuth Web client ID (Firebase Console → Project settings → OAuth client type Web)
# Required for native Google Sign-In ID tokens (android release & debug)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=246872619658-5dm89l8189ql00m4ab84no0onon4osbk.apps.googleusercontent.com

# Optional: log [perf] startup marks + FPS samples in release builds (always on in __DEV__)
# EXPO_PUBLIC_PERF_MARKS=1

# Android Release Signing (Kept secret in local .env, NEVER commit passwords)
MYAPP_RELEASE_STORE_PASSWORD=
MYAPP_RELEASE_KEY_PASSWORD=
