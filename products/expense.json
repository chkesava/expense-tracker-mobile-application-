{
  "product": "expense",
  "version": "2.0.10",
  "versionCode": 95,
  "name": "Spendly",
  "slug": "spendly",
  "scheme": "spendly",
  "package": "com.example.expensetracker",
  "permissions": [
    "android.permission.USE_BIOMETRIC",
    "android.permission.USE_FINGERPRINT",
    "android.permission.READ_SMS",
    "android.permission.RECEIVE_SMS",
    "android.permission.POST_NOTIFICATIONS",
    "android.permission.REQUEST_INSTALL_PACKAGES"
  ],
  "extraPlugins": [
    [
      "expo-quick-actions",
      {
        "androidIcons": {
          "shortcut_expense": {
            "foregroundImage": "./assets/branding/adaptive-icon.png",
            "backgroundColor": "#071A2B"
          },
          "shortcut_income": {
            "foregroundImage": "./assets/branding/adaptive-icon.png",
            "backgroundColor": "#0B3D2E"
          },
          "shortcut_receipt": {
            "foregroundImage": "./assets/branding/adaptive-icon.png",
            "backgroundColor": "#3D2A0B"
          },
          "shortcut_accounts": {
            "foregroundImage": "./assets/branding/adaptive-icon.png",
            "backgroundColor": "#1A2744"
          }
        },
        "iosActions": [
          {
            "id": "expense.add",
            "title": "Add Expense",
            "subtitle": "Log a new expense",
            "icon": "add",
            "params": {
              "shortcutId": "expense.add"
            }
          },
          {
            "id": "income.add",
            "title": "Add Income",
            "subtitle": "Log a new income",
            "icon": "compose",
            "params": {
              "shortcutId": "income.add"
            }
          },
          {
            "id": "receipt.add",
            "title": "Scan Receipt",
            "subtitle": "Capture a receipt",
            "icon": "capturePhoto",
            "params": {
              "shortcutId": "receipt.add"
            }
          },
          {
            "id": "accounts.open",
            "title": "Accounts",
            "subtitle": "Open accounts",
            "icon": "home",
            "params": {
              "shortcutId": "accounts.open"
            }
          }
        ]
      }
    ]
  ],
  "web": {
    "basePath": "/expense",
    "shortName": "Spendly",
    "themeColor": "#071A2B",
    "backgroundColor": "#071A2B",
    "description": "Personal ledger, accounts, splits and vaults.",
    "manifestIcon": "./assets/branding/icon.png"
  }
}
