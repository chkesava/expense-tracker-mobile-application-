{
  "product": "nutrition",
  "version": "1.0.2",
  "versionCode": 3,
  "name": "Spendly Nutrition",
  "slug": "spendly-nutrition",
  "scheme": "spendlynutrition",
  "package": "com.example.nutritiontrackera",
  "icon": "./assets/branding/nutrition-adaptive-icon.png",
  "adaptiveIconForeground": "./assets/branding/nutrition-adaptive-icon.png",
  "splashImage": "./assets/branding/nutrition-splash-logo.png",
  "permissions": [
    "android.permission.USE_BIOMETRIC",
    "android.permission.USE_FINGERPRINT",
    "android.permission.POST_NOTIFICATIONS"
  ],
  "extraPlugins": [
    [
      "expo-image-picker",
      {
        "photosPermission": "Allow Spendly Nutrition to attach a photo of your meal.",
        "cameraPermission": "Allow Spendly Nutrition to photograph your meal."
      }
    ]
  ]
}
