{
  "product": "nutrition",
  "version": "1.0.4",
  "versionCode": 5,
  "name": "Spendly Nutrition",
  "slug": "spendly-nutrition",
  "scheme": "spendlynutrition",
  "package": "com.example.nutritiontrackera",
  "icon": "./assets/branding/nutrition-adaptive-icon.png",
  "adaptiveIconForeground": "./assets/branding/nutrition-adaptive-icon.png",
  "splashImage": "./assets/branding/nutrition-splash-logo.png",
  "permissions": [
    "android.permission.USE_BIOMETRIC",
    "android.permission.USE_FINGERPRINT",
    "android.permission.POST_NOTIFICATIONS",
    "android.permission.REQUEST_INSTALL_PACKAGES"
  ],
  "extraPlugins": [
    [
      "expo-image-picker",
      {
        "photosPermission": "Allow Spendly Nutrition to attach a photo of your meal.",
        "cameraPermission": "Allow Spendly Nutrition to photograph your meal."
      }
    ]
  ],
  "web": {
    "basePath": "/nutrition",
    "shortName": "Nutrition",
    "themeColor": "#166534",
    "backgroundColor": "#071A2B",
    "description": "Meal logging, food photo analysis and nutrition insights.",
    "manifestIcon": "./assets/branding/nutrition-adaptive-icon.png"
  }
}
