{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "moduleResolution": "node",
    "outDir": "lib",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
