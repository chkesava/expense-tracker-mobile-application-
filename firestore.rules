rules_version = '2';

// Reference source of truth for Firestore security. This file is NOT deployed
// by CI — see docs/FIREBASE_RULES_DEPLOY.md for the manual deploy step.
//
// Ownership model: every personal record lives under `users/{uid}/...`, where
// `uid` is the uid the app writes with. Duress mode swaps the app-level uid to
// `<real uid>_duress` (see lib/authHelpers.ts and lib/duressPath.contract.test.ts),
// so an owned path is either the auth uid or that uid with the duress suffix.
// Both resolve to the same signed-in person, so both are allowed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn()
        && (uid == request.auth.uid || uid == request.auth.uid + '_duress');
    }

    // -----------------------------------------------------------------------
    // Personal data — users/{uid}/...
    //
    // Collections currently written by the app:
    //   accountEntries, accountPayments, accounts, accountTransfers,
    //   accountTypes, alerts, borrowingRepayments, borrowings, categories,
    //   categorizationRules, categoryBudgets, epfContributionEvents,
    //   epfContributions, epfEstablishments, epfProfile,
    //   epfInterestEntries, epfReconciliations, epfTransferEvents,
    //   epfTransfers, expenses, financialGoals, focus,
    //   holdings, incomes, investments, meta, portfolioOrders,
    //   portfolioSettings, portfolioSnapshots, portfolioTransactions,
    //   receivableRepayments, receivables, spaces,
    //   stats, subscriptions, recurringDismissals, trips, watchlist
    //
    // The recursive match keeps a new collection from silently becoming
    // unreadable the moment it ships, while still confining everything to the
    // owning user.
    // -----------------------------------------------------------------------
    match /users/{uid} {
      // SPENDLY-34: `role` is the Spendly SUPER_ADMIN flag. The owner grant
      // used to be field-agnostic, so any signed-in account could self-assign
      // it and bypass maintenanceMode. Clients still write username/settings
      // on this doc; they must not create or change `role`. Console / Admin
      // SDK remain the only writers of SUPER_ADMIN.
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && (!request.resource.data.keys().hasAny(['role'])
            || request.resource.data.role == 'USER');
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isOwner(uid);

      // KAN-9: pandalMemberships is matched separately with a field
      // allowlist and a live-member check. Nested matches OR together, so
      // this recursive owner grant must not cover that collection or a
      // client could forge role/status on their own index.
      //
      // The excluded name is read off `{collection}`, a single-segment
      // wildcard, and never off the recursive `{document=**}`. A recursive
      // wildcard is unbound on a `list`, so indexing it there raises
      // "Variable is not bound in path template" and denies the query --
      // which took every personal collection list (expenses, accounts,
      // statements, ...) down while single-document gets and writes kept
      // working.
      //
      // SPENDLY-10: money collections below are matched with amount/date
      // checks. They must stay out of this wildcard or the OR would still
      // allow amount: -1e12. Remaining personal collections stay on this
      // grant until later slices. App Check is a leftover, not this slice.
      function personalMoneyWellFormed() {
        let d = request.resource.data;
        return d.amount is number
          && d.amount >= 0
          && d.amount < 1000000000
          && (!d.keys().hasAny(['date'])
              || (d.date is string
                  && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
      }

      match /expenses/{expenseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && personalMoneyWellFormed();
      }

      match /incomes/{incomeId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && personalMoneyWellFormed();
      }

      match /accountEntries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && personalMoneyWellFormed();
      }

      match /accountPayments/{paymentId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && personalMoneyWellFormed();
      }

      match /accountTransfers/{transferId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && personalMoneyWellFormed();
      }

      match /{collection}/{document=**} {
        allow read, write: if isOwner(uid)
          && collection != 'pandalMemberships'
          && collection != 'expenses'
          && collection != 'incomes'
          && collection != 'accountEntries'
          && collection != 'accountPayments'
          && collection != 'accountTransfers';
      }
    }

    // -----------------------------------------------------------------------
    // Shared data — readable by the people named on the document.
    // -----------------------------------------------------------------------
    match /vaults/{vaultId} {
      function isVaultMember() {
        return signedIn()
          && (resource.data.ownerId == request.auth.uid
              || request.auth.uid in resource.data.memberIds);
      }

      function isVaultOwner() {
        return signedIn() && resource.data.ownerId == request.auth.uid;
      }

      // Membership/ownership are not client-writable after create. Without
      // this, a member could rewrite ownerId/memberIds, and an owner could
      // push an unsolicited vault into anyone's list. Adding people later
      // needs an invite/accept flow (SPENDLY-31 leftover).
      function keepsOwnershipStable() {
        return request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.memberIds == resource.data.memberIds;
      }

      function createMembershipSelfOnly() {
        return request.resource.data.ownerId == request.auth.uid
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() == 1
          && request.resource.data.memberIds[0] == request.auth.uid;
      }

      allow read: if isVaultMember();
      allow delete: if isVaultOwner();
      allow update: if isVaultOwner() && keepsOwnershipStable();
      allow create: if signedIn() && createMembershipSelfOnly();

      match /expenses/{expenseId} {
        function parentVault() {
          return get(/databases/$(database)/documents/vaults/$(vaultId)).data;
        }

        function isParentMember() {
          return signedIn()
            && (parentVault().ownerId == request.auth.uid
                || request.auth.uid in parentVault().memberIds);
        }

        // The app stores the payer on `createdBy` (not `paidBy`). Amounts are
        // always positive; deposit vs withdrawal is `type`.
        function expenseWellFormed() {
          return request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.type in ['deposit', 'withdrawal'];
        }

        function canMutateExpense() {
          return resource.data.createdBy == request.auth.uid
            || parentVault().ownerId == request.auth.uid;
        }

        allow read: if isParentMember();
        allow create: if isParentMember() && expenseWellFormed();
        allow update: if isParentMember()
          && canMutateExpense()
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isParentMember() && canMutateExpense();
      }
    }

    match /splits/{splitId} {
      function isSplitParticipant() {
        return signedIn()
          && (resource.data.createdBy == request.auth.uid
              || request.auth.uid in resource.data.participantIds);
      }

      function isSplitCreator() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      // SPENDLY-32: a debtor used to settle, zero, rewrite participants[],
      // or delete the split. Money and membership live on this doc, so only
      // the organizer may write it. Friends file via splitShareClaims; the
      // organizer applies. createdBy is never client-rewritable.
      // participantIds stay creator-writable so Add person still works.
      function keepsCreatorStable() {
        return request.resource.data.createdBy == resource.data.createdBy;
      }

      function splitAmountsWellFormed() {
        return request.resource.data.totalAmount is number
          && request.resource.data.totalAmount >= 0
          && (!request.resource.data.keys().hasAny(['settled'])
              || request.resource.data.settled is bool);
      }

      allow read: if isSplitParticipant();
      allow delete: if isSplitCreator();
      allow update: if isSplitCreator()
        && keepsCreatorStable()
        && splitAmountsWellFormed();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && splitAmountsWellFormed();
    }

    // Public /payment/:slug and /split/:slug pages. SPENDLY-36: `read: if true`
    // included `list`, so anyone could dump names + UPI + amounts. Public
    // access is get-by-slug (the slug is the document id). Organizers still
    // query `paymentRequests` by createdBy; splitPublicShares are never listed.
    // createdBy is pinned so a request cannot be planted in someone else's
    // Collect list. New creates must use slug as the document id.
    match /paymentRequests/{requestId} {
      function isRequestCreator() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      allow get: if true;
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow delete: if isRequestCreator();
      allow update: if isRequestCreator()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.slug == requestId;
    }

    match /splitPublicShares/{shareId} {
      function isShareCreator() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      allow get: if true;
      allow list: if false;
      allow delete: if isShareCreator();
      allow update: if isShareCreator()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.slug == shareId;
    }

    // Self-service updates filed from the public /split/:slug page by people who
    // are not signed in. This is the only collection in the project that accepts
    // an unauthenticated write, so every clause below is load-bearing.
    //
    // What keeps it bounded with no server and no auth:
    //  * The document id is derived from (shareId, participantKey), so one
    //    person on one split has exactly one claim slot. An anonymous writer
    //    cannot create documents at will -- only fill a slot the organizer
    //    already published in `claimKeys`.
    //  * `create` is the only anonymous write. An existing document makes a
    //    client setDoc an *update*, which is refused, so the lifetime anonymous
    //    write budget per slot is one. The slot is re-armed only when the
    //    organizer applies or dismisses the claim (an owner delete).
    //  * Anonymous delete is refused on purpose: delete-then-create would reset
    //    that budget and make the write volume unbounded again.
    //  * The parent share must still exist, still be open, and still carry
    //    `claimsEnabled` -- the organizer's kill switch. A share with the flag
    //    absent is closed, so shares written before this feature reject claims
    //    until the organizer next touches the split.
    //  * A claim changes nothing. It credits no account and does not alter the
    //    public share. Applying one is an organizer-only write to `splits`.
    //    That review step IS the security model: `personSlug` and `claimKeys`
    //    are already world-readable, so anyone holding the group link can file
    //    a claim as anyone, and no secret could fix that -- a secret stored in
    //    a world-readable document is not a secret.
    //
    // `list` is closed so the collection cannot be enumerated: the public page
    // (from `claimKeys`) and the organizer (from the split's participants) both
    // already know every document id, and read them directly by id.
    match /splitShareClaims/{claimId} {
      function claimFields() {
        return [
          'shareId', 'slug', 'participantKey', 'type',
          'amount', 'status', 'createdAt', 'updatedAt'
        ];
      }

      function sharePath(shareId) {
        return /databases/$(database)/documents/splitPublicShares/$(shareId);
      }

      function isShareOwner() {
        return signedIn()
          && exists(sharePath(resource.data.shareId))
          && get(sharePath(resource.data.shareId)).data.createdBy == request.auth.uid;
      }

      // Once the organizer deletes the split the parent share is gone, so an
      // orphan claim would otherwise be undeletable forever. An orphan is inert
      // (nothing renders it, and `create` needs a live share, so this cannot be
      // used to re-arm a slot), which makes it safe to let anyone clear it.
      function isOrphan() {
        return !exists(sharePath(resource.data.shareId));
      }

      function wellFormed() {
        let d = request.resource.data;
        return d.keys().hasOnly(claimFields())
          && d.keys().hasAll(claimFields())
          && d.shareId is string && d.shareId.size() > 0 && d.shareId.size() <= 64
          && d.slug is string && d.slug.size() >= 6 && d.slug.size() <= 64
          && d.participantKey is string
          && d.participantKey.size() > 0 && d.participantKey.size() <= 64
          && d.type in ['paid', 'optOut']
          && d.amount is number
          && d.amount >= 0
          && d.status == 'pending'
          && d.createdAt is int
          && d.updatedAt is int
          && d.createdAt == d.updatedAt
          && d.createdAt > request.time.toMillis() - 300000
          && d.createdAt < request.time.toMillis() + 300000;
      }

      function matchesLiveShare() {
        let d = request.resource.data;
        let s = get(sharePath(d.shareId)).data;
        return claimId == d.shareId + '__' + d.participantKey
          && s.claimsEnabled == true
          && s.slug == d.slug
          && d.participantKey in s.claimKeys
          && d.amount <= s.claimAmountMax
          && s.status != 'settled'
          && s.status != 'spent';
      }

      allow get: if true;
      allow list: if false;

      allow create: if wellFormed() && matchesLiveShare();
      allow update: if isShareOwner();
      allow delete: if isShareOwner() || isOrphan();
    }

    // App-wide flags (`global`) and the sideloaded APK pointer (`latest_release`).
    // Release docs are public GitHub APK URLs — readable without auth so the
    // update prompt can attach before sign-in finishes (Ganesh login especially).
    // Clients cannot write any doc here: `global` is a project-wide kill switch
    // (maintenance, signup gate, banner, feature flags). Onboarding currency
    // lives on `users/{uid}`. Product docs are written by the Admin SDK in CI.
    match /system_settings/{docId} {
      // Must live INSIDE the match: `docId` is bound by the match, so a
      // top-level function referencing it compiles with "Invalid variable
      // name: docId" and then errors at call time. An errored condition
      // denies, which silently killed the signed-out read this grant exists
      // for -- the update prompt could not attach before sign-in.
      function isReleasePointer() {
        return docId == "latest_release"
          || docId == "latest_release_expense"
          || docId == "latest_release_nutrition"
          || docId == "latest_release_ganesh";
      }

      // `global` is flags only (maintenance, signups, currency). Writes are
      // locked, so signed-out get is safe: login can honour disableSignups
      // without a live listener dying on permission-denied (SEC-08).
      allow get: if isReleasePointer() || docId == "global" || signedIn();
      allow list: if signedIn();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Ganesh Seva — shared Pandal / Festival ledger.
    // ACTIVE membership is the only grant. ownerId / memberIds alone are not.
    // Role helpers mirror shared/utils/ganeshPermissions.ts.
    // Admin-only UI is not enough: memberAudits / festival auditLogs reads and
    // category writes are limited to admin (and treasurer where the TS matrix
    // already grants festival.update / audit.read).
    // -----------------------------------------------------------------------
    function ganeshIdentityCreate() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function ganeshIdentityUpdate() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function ganeshMemberDoc(pandalId) {
      return get(/databases/$(database)/documents/pandals/$(pandalId)/members/$(request.auth.uid));
    }

    function isActivePandalMemberOf(pandalId) {
      return signedIn()
        && exists(/databases/$(database)/documents/pandals/$(pandalId)/members/$(request.auth.uid))
        && ganeshMemberDoc(pandalId).data.status == 'active';
    }

    function ganeshRoleOf(pandalId) {
      return ganeshMemberDoc(pandalId).data.role;
    }

    function hasPermissionsField(pandalId) {
      return ganeshMemberDoc(pandalId).data.keys().hasAny(['permissions']);
    }

    function hasPermOf(pandalId, perm) {
      return isActivePandalMemberOf(pandalId) && (
        ganeshRoleOf(pandalId) == 'admin'
        || (
          hasPermissionsField(pandalId)
          && perm in ganeshMemberDoc(pandalId).data.permissions
        )
      );
    }

    // The UI gates every audit surface on `audit.read`, so the rules must too.
    // Previously these reads were gated on festival.update/.close, which both
    // over-exposed them (a role with festival.update but not audit.read could
    // read them from the SDK) and under-exposed them (a role granted audit.read
    // saw the section render and the query fail) — GS-016.
    function canReadAuditOf(pandalId) {
      return hasPermOf(pandalId, 'audit.read')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canManageMembersOf(pandalId) {
      return isActivePandalMemberOf(pandalId) && ganeshRoleOf(pandalId) == 'admin';
    }

    // Mirrors expandPermissions(ROLE_PERMISSIONS.member) in
    // shared/utils/ganeshPermissions.ts. `hasPermOf` reads the member
    // document's `permissions` array, so a self-created membership must not be
    // allowed to name a set wider than this. Keep the two in sync.
    function builtinMemberPermissions() {
      return [
        'collections.read', 'expenses.read', 'contributions.read',
        'reimbursements.read', 'members.read', 'permanentFund.read',
        'festival.read', 'assets.read', 'sponsors.read',
        'collections.create', 'collections.update',
        'expenses.create', 'expenses.update',
        'contributions.create', 'contributions.update',
        'assets.create', 'sponsors.create', 'sponsors.update',
        'seva.read',
        // KAN-125: read only. A self-joining member may see the token list,
        // and nothing about selling, configuring or drawing.
        'tokens.read',
        // KAN-126: a member records prasadam. Counter-side data entry is
        // the whole point of the feature, so write is included here - but
        // not `prasadam.cancel`, which is the audited reversal.
        'prasadam.read', 'prasadam.write'
      ];
    }

    function canWriteCollectionOf(pandalId) {
      return hasPermOf(pandalId, 'collections.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer', 'member', 'collector']
        );
    }

    function canWriteExpenseOrContributionOf(pandalId) {
      return hasPermOf(pandalId, 'expenses.create')
        || hasPermOf(pandalId, 'contributions.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer', 'member']
        );
    }

    function canReceiveContributionOf(pandalId) {
      return hasPermOf(pandalId, 'contributions.receive')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canCancelContributionOf(pandalId) {
      return hasPermOf(pandalId, 'contributions.cancel')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canWriteReimbursementOf(pandalId) {
      return hasPermOf(pandalId, 'reimbursements.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canWritePermanentFundOf(pandalId) {
      return hasPermOf(pandalId, 'permanentFund.transfer')
        || hasPermOf(pandalId, 'permanentFund.add')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) == 'admin'
        );
    }

    function canCloseOrUpdateFestivalOf(pandalId) {
      return hasPermOf(pandalId, 'festival.update')
        || hasPermOf(pandalId, 'festival.close')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canCreateFestivalOf(pandalId) {
      return hasPermOf(pandalId, 'festival.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) == 'admin'
        );
    }

    function canCreateOpeningFundOf(pandalId) {
      return hasPermOf(pandalId, 'openingFunds.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canReadSponsorOf(pandalId) {
      return hasPermOf(pandalId, 'sponsors.read')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
        );
    }

    function canCreateSponsorOf(pandalId) {
      return hasPermOf(pandalId, 'sponsors.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer', 'member']
        );
    }

    function canUpdateSponsorOf(pandalId) {
      return hasPermOf(pandalId, 'sponsors.update')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canReceiveSponsorOf(pandalId) {
      return hasPermOf(pandalId, 'sponsors.receive')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canCancelSponsorOf(pandalId) {
      return hasPermOf(pandalId, 'sponsors.cancel')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canWriteSponsorOf(pandalId) {
      return canCreateSponsorOf(pandalId)
        || canUpdateSponsorOf(pandalId)
        || canReceiveSponsorOf(pandalId)
        || canCancelSponsorOf(pandalId);
    }

    // Seva schedule. A seva carries no money, so these helpers gate planning
    // and staffing only; nothing here can move a rupee.
    function canPlanSevaOf(pandalId) {
      return hasPermOf(pandalId, 'seva.write')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canAssignSevaOf(pandalId) {
      return hasPermOf(pandalId, 'seva.assign')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canWriteSevaOf(pandalId) {
      return canPlanSevaOf(pandalId) || canAssignSevaOf(pandalId);
    }

    // GS-076 / GS-075 --------------------------------------------------
    function canWriteSessionOf(pandalId) {
      return hasPermOf(pandalId, 'sessions.write');
    }
    function canReadSessionOf(pandalId) {
      return hasPermOf(pandalId, 'sessions.read') || hasPermOf(pandalId, 'reconciliation.read');
    }
    function canCountCashOf(pandalId) {
      return hasPermOf(pandalId, 'reconciliation.count');
    }
    function canApproveReconciliationOf(pandalId) {
      return hasPermOf(pandalId, 'reconciliation.approve');
    }
    function canResolveReconciliationOf(pandalId) {
      return hasPermOf(pandalId, 'reconciliation.resolve');
    }

    // KAN-125 — Token Laddu.
    //
    // Three separate authorities on purpose. `tokens.config` sets how many
    // laddus exist, and raising that number is the only legitimate way past the
    // capacity check — so whoever holds it can authorize exceeding what was
    // originally configured. `draw.run` is the public, irreversible act, and
    // selling a token should not carry the authority to pick the winner.
    //
    // Reads are gated too, not left to `isActivePandalMember()`: a token row
    // carries the participant's name and mobile, which is exactly the donor PII
    // GS-073 keeps from viewers.
    function canReadTokensOf(pandalId) {
      return hasPermOf(pandalId, 'tokens.read');
    }
    function canWriteTokensOf(pandalId) {
      return hasPermOf(pandalId, 'tokens.write');
    }
    function canConfigureTokensOf(pandalId) {
      return hasPermOf(pandalId, 'tokens.config');
    }
    function canRunDrawOf(pandalId) {
      return hasPermOf(pandalId, 'draw.run');
    }

    // KAN-126 - the prasadam register.
    //
    // No legacy role fallback on any of these, for the same reason KAN-125
    // has none: these keys did not exist when the old member documents were
    // written, so `ensurePandalRoles` grants them rather than a role string
    // implying them.
    //
    // Reads are gated rather than left to `isActivePandalMember()`: an entry
    // names the devotee who fed the pandal and carries their mobile, which
    // is the same donor PII GS-073 keeps from viewers.
    //
    // Write is wider than seva's (member and collector hold it) because the
    // people recording are volunteers at the counter. Cancel is narrower,
    // because reversing a recorded offering is the audited correction.
    function canReadPrasadamOf(pandalId) {
      return hasPermOf(pandalId, 'prasadam.read');
    }
    function canWritePrasadamOf(pandalId) {
      return hasPermOf(pandalId, 'prasadam.write');
    }
    function canCancelPrasadamOf(pandalId) {
      return hasPermOf(pandalId, 'prasadam.cancel');
    }

    function canWriteLedgerSideEffectOf(pandalId) {
      return canWriteCollectionOf(pandalId)
        || canWriteExpenseOrContributionOf(pandalId)
        || canWriteReimbursementOf(pandalId)
        || canCreateOpeningFundOf(pandalId)
        || canWritePermanentFundOf(pandalId)
        || canCloseOrUpdateFestivalOf(pandalId)
        || canWriteSponsorOf(pandalId);
    }

    // Donor PII read gates (GS-073). Assets and sponsors already gate reads on
    // a permission; the ledger did not, so every active member — `viewer`
    // included — could read every household's name, mobile number and address.
    //
    // `households` is gated with `collections` on purpose: it carries the same
    // name, house number and mobile, so gating only `collections` would leave
    // the same data readable one collection over. The ticket did not mention it.
    //
    // The `!hasPermissionsField` fallback is the same legacy clause the asset
    // and sponsor gates use: a member document written before RBAC has no
    // `permissions` array, and must not lose access on the day these deploy.
    function canReadCollectionsOf(pandalId) {
      return hasPermOf(pandalId, 'collections.read')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
        );
    }

    function canReadContributionsOf(pandalId) {
      return hasPermOf(pandalId, 'contributions.read')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
        );
    }

    function canReadAssetOf(pandalId) {
      return hasPermOf(pandalId, 'assets.read')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
        );
    }

    function canCreateAssetOf(pandalId) {
      return hasPermOf(pandalId, 'assets.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer', 'member']
        );
    }

    function canUpdateAssetOf(pandalId) {
      return hasPermOf(pandalId, 'assets.update')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canDisposeAssetOf(pandalId) {
      return hasPermOf(pandalId, 'assets.dispose')
        || hasPermOf(pandalId, 'assets.manage')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) == 'admin'
        );
    }

    function canWriteAssetOf(pandalId) {
      return canCreateAssetOf(pandalId)
        || canUpdateAssetOf(pandalId)
        || canDisposeAssetOf(pandalId);
    }

    // Approving a join request stamps users/{uid}/pandalMemberships/{pandalId}.
    // The personal users/{uid} tree is owner-only, so this is the explicit
    // exception — still limited to a Pandal the writer actually admins.
    //
    // KAN-9: the owner branch used to accept any payload. Real authorization
    // still reads pandals/.../members/{uid}, but a forged role/status on the
    // index can mislead the Pandal list. Owner writes must now match the live
    // member document and the same field allowlist as the admin stamp.
    match /users/{uid}/pandalMemberships/{pandalId} {
      function membershipIndexMemberPath() {
        return /databases/$(database)/documents/pandals/$(pandalId)/members/$(uid);
      }

      function membershipIndexKeysAllowed() {
        return request.resource.data.keys().hasOnly([
          'pandalId', 'role', 'status', 'pandalName', 'joinedAt', 'updatedAt'
        ]);
      }

      function membershipIndexStatusOk() {
        return request.resource.data.status in ['active', 'suspended', 'removed'];
      }

      function membershipIndexMatchesLiveMember() {
        let live = getAfter(membershipIndexMemberPath()).data;
        let liveStatus = live.keys().hasAny(['status']) && live.status is string
          ? live.status
          : 'active';
        return existsAfter(membershipIndexMemberPath())
          && request.resource.data.pandalId == pandalId
          && request.resource.data.role == live.role
          && request.resource.data.status == liveStatus
          && membershipIndexStatusOk();
      }

      allow read: if isOwner(uid);
      allow create, update: if membershipIndexKeysAllowed()
        && request.resource.data.pandalId == pandalId
        && request.resource.data.role is string
        && membershipIndexStatusOk()
        && (
          (isOwner(uid) && membershipIndexMatchesLiveMember())
          || canManageMembersOf(pandalId)
        );
      allow delete: if isOwner(uid) || canManageMembersOf(pandalId);
    }

    match /pandalInvites/{code} {
      // A join code is a bearer secret. `read` would also grant `list`, which
      // would let any signed-in account enumerate every Pandal id, name and
      // join code in the project. The invitee already knows the code and reads
      // the document by id, so `get` alone is enough.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.pandalId is string
        // GS-043: without this, anyone could mint pandalInvites/<code> carrying
        // another committee's pandalId and an arbitrary name — a phishing and
        // code-squatting vector against uniquePandalCode()'s retry loop.
        && canManageMembersOf(request.resource.data.pandalId);
      allow update: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || canManageMembersOf(resource.data.pandalId)
        );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /pandalJoinRequests/{requestId} {
      // Applicant name and phone. The UI shows this only to members.approve
      // holders, which the rules treat as admin-only — every member including
      // `viewer` could previously list it from the SDK (GS-016).
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
            || canManageMembersOf(resource.data.pandalId));
      // One slot per user per pandal (GS-042). The client already writes
      // `{pandalId}__{uid}` by convention; nothing enforced it, so a single
      // account could mint unlimited requests with attacker-controlled
      // displayName and phone strings, and `allow delete: if false` meant an
      // admin could never clear them. The queue was floodable and permanent.
      function idIsOwnSlot() {
        return requestId == request.resource.data.pandalId + '__' + request.auth.uid;
      }
      // KAN-10: a guessed pandalId used to mint a pending request against a
      // Pandal that does not exist. Invite-code proof stays on KAN-15.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && idIsOwnSlot()
        && request.resource.data.pandalId is string
        && exists(/databases/$(database)/documents/pandals/$(request.resource.data.pandalId));
      allow update: if (
          canManageMembersOf(resource.data.pandalId)
          && request.resource.data.pandalId == resource.data.pandalId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status in ['approved', 'rejected']
        ) || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.pandalId == resource.data.pandalId
          && request.resource.data.status == 'pending'
        );
      // An admin of the target pandal can dismiss a request, which is what
      // makes a flooded queue recoverable; the requester can withdraw their own
      // (GS-042). This was `if false`, so nothing could ever be cleared.
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid
        || canManageMembersOf(resource.data.pandalId)
      );
    }

    match /pandals/{pandalId} {
      function pandalData() {
        return get(/databases/$(database)/documents/pandals/$(pandalId)).data;
      }
      // An archived pandal is readable but frozen (GS-017): the committee keeps
      // its whole money history, and nothing new can be written to it.
      //
      // Deliberately NOT folded into `hasPermOf`, which also backs reads
      // (`canReadAuditOf`) — guarding there would take the audit trail away at
      // the moment it matters most. The freeze is applied to the write
      // predicates only, and the pandal document's own `allow update` is left
      // out of it so an admin can still restore.
      function pandalNotArchived() {
        return !(pandalData().keys().hasAny(['archived']) && pandalData().archived == true);
      }
      function pandalAfter() {
        return getAfter(/databases/$(database)/documents/pandals/$(pandalId)).data;
      }
      function isActivePandalMember() {
        return isActivePandalMemberOf(pandalId);
      }
      function canManageMembers() {
        return canManageMembersOf(pandalId);
      }
      function canWriteCollection() {
        return canWriteCollectionOf(pandalId);
      }
      function canWriteExpenseOrContribution() {
        return canWriteExpenseOrContributionOf(pandalId);
      }
      function canWriteReimbursement() {
        return canWriteReimbursementOf(pandalId);
      }
      function canWritePermanentFund() {
        return canWritePermanentFundOf(pandalId);
      }
      function canCloseOrUpdateFestival() {
        return canCloseOrUpdateFestivalOf(pandalId);
      }
      function canCreateFestival() {
        return canCreateFestivalOf(pandalId);
      }
      function canCreateOpeningFund() {
        return canCreateOpeningFundOf(pandalId);
      }
      function canWriteLedgerSideEffect() {
        return canWriteLedgerSideEffectOf(pandalId);
      }
      // `ownerId` may move, but only onto an active admin of this same pandal
      // (GS-017). It was pinned permanently immutable, so a founder who had
      // left could never hand the pandal over. The actor is already an active
      // admin — `allow update` requires canManageMembers() — so this is
      // admin-to-admin by construction, which is the point: requiring the
      // departed founder's participation would make ownership unmovable in
      // exactly the case that matters.
      //
      // One get(), reading both fields, to stay inside the per-evaluation
      // document access budget.
      function ownerCandidate() {
        return get(/databases/$(database)/documents/pandals/$(pandalId)/members/$(request.resource.data.ownerId)).data;
      }
      function ownerIsActiveAdmin() {
        return exists(/databases/$(database)/documents/pandals/$(pandalId)/members/$(request.resource.data.ownerId))
          && ownerCandidate().status == 'active'
          && ownerCandidate().role == 'admin';
      }
      function keepsPandalCore() {
        return (
            request.resource.data.ownerId == resource.data.ownerId
            || ownerIsActiveAdmin()
          )
          && request.resource.data.code == resource.data.code
          && adminCountDeltaBounded();
      }
      function currentAdminCount() {
        return pandalData().keys().hasAny(['adminCount']) && pandalData().adminCount is number
          ? pandalData().adminCount
          : 1;
      }
      // `adminCount` predates nothing that backfilled it, so a pandal created
      // before the field exists reads as 1 rather than erroring. Without this
      // guard every member update on such a pandal is denied — including the
      // migration that would repair it (GS-014).
      function afterAdminCount() {
        return pandalAfter().keys().hasAny(['adminCount']) && pandalAfter().adminCount is number
          ? pandalAfter().adminCount
          : 1;
      }
      // Last-admin protection trusts this counter, so an admin must not be able
      // to inflate it in one write and then demote every admin past the
      // `>= 1` floor. Reads `resource` directly — no extra document read.
      //
      // This BOUNDS the hole rather than closing it (GS-015): a determined admin
      // can still walk the counter up one allowed update at a time. Closing it
      // properly needs the counter maintained server-side, or the pandal write to
      // name the member whose transition justifies the delta so the rule can
      // verify it with getAfter.
      function adminCountDeltaBounded() {
        let before = resource.data.keys().hasAny(['adminCount'])
          && resource.data.adminCount is number
          ? resource.data.adminCount
          : 1;
        let after = request.resource.data.keys().hasAny(['adminCount'])
          && request.resource.data.adminCount is number
          ? request.resource.data.adminCount
          : 1;
        return after >= 1 && after >= before - 1 && after <= before + 1;
      }

      allow read: if isActivePandalMember();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.adminCount == 1
        && ganeshIdentityCreate();
      allow update: if canManageMembers() && keepsPandalCore();
      // No hard delete, by anyone (GS-017).
      //
      // This line used to read `signedIn() && resource.data.ownerId ==
      // request.auth.uid`, which had no membership check at all: a founder who
      // had been suspended, removed or demoted months earlier could still
      // destroy the pandal. That contradicted the principle stated at the top
      // of this file — "ACTIVE membership is the only grant. ownerId /
      // memberIds alone are not."
      //
      // Requiring an active admin instead would have closed that, but deleting
      // a pandal can never be a good outcome here. Firestore does not cascade,
      // so every subcollection survives — members, festivals, collections,
      // expenses, permanentFund, auditLogs — while the rules that reach them
      // call `pandalData()`, a get() on the now-missing parent, and therefore
      // start denying. The records end up unreachable *and* undeletable, and
      // the money trail this app exists to keep is gone irreversibly.
      //
      // Archive is the replacement: reversible, keeps everything readable, and
      // refuses while a festival is still open. See `setPandalArchived`.
      allow delete: if false;

      match /members/{memberId} {
        function wasActiveAdmin() {
          return resource.data.role == 'admin' && resource.data.status == 'active';
        }
        function willBeActiveAdmin() {
          return request.resource.data.role == 'admin'
            && request.resource.data.status == 'active';
        }
        function keepsAdminCount() {
          return wasActiveAdmin() && !willBeActiveAdmin()
            ? afterAdminCount() == currentAdminCount() - 1
              && afterAdminCount() >= 1
            : !wasActiveAdmin() && willBeActiveAdmin()
              ? afterAdminCount() == currentAdminCount() + 1
              : afterAdminCount() == currentAdminCount();
        }
        // The create rule has no `resource`, so the before-state helpers above
        // cannot be reused. An admin adding an already-active admin must still
        // move the counter, or the count silently understates reality (GS-015).
        function createKeepsAdminCount() {
          return willBeActiveAdmin()
            ? afterAdminCount() == currentAdminCount() + 1
            : afterAdminCount() == currentAdminCount();
        }
        // The open-join branch below is the one path where a user writes their
        // own membership without an admin in the loop. `permissions` is what
        // authorizes every later action, so it must not be self-declared.
        function selfJoinClaimsNoExtraPower() {
          return (
            !request.resource.data.keys().hasAny(['permissions'])
            || (
              request.resource.data.permissions is list
              && request.resource.data.permissions.hasOnly(builtinMemberPermissions())
            )
          ) && (
            !request.resource.data.keys().hasAny(['roleIds'])
            || (
              request.resource.data.roleIds is list
              && request.resource.data.roleIds.hasOnly(['member'])
            )
          );
        }
        function cannotSelfPromoteToAdmin() {
          return !(memberId == request.auth.uid
            && request.resource.data.role == 'admin'
            && resource.data.role != 'admin');
        }

        allow read: if isActivePandalMember() || memberId == request.auth.uid;
        allow create: if signedIn()
          && (
            (
              memberId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.status == 'active'
              && (
                (
                  request.resource.data.role == 'admin'
                  && pandalAfter().ownerId == request.auth.uid
                )
                || (
                  request.resource.data.role == 'member'
                  && pandalAfter().joinMode == 'open'
                  && selfJoinClaimsNoExtraPower()
                )
              )
            )
            || (
              canManageMembers()
              && request.resource.data.role in ['admin', 'treasurer', 'member', 'collector', 'viewer']
              && createKeepsAdminCount()
            )
          );
        function isSelfLeave() {
          return memberId == request.auth.uid
            && resource.data.status == 'active'
            && request.resource.data.status == 'removed'
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.role == resource.data.role
            && keepsAdminCount();
        }

        allow update: if (
            (
              canManageMembers()
              && request.resource.data.userId == resource.data.userId
              && cannotSelfPromoteToAdmin()
              && keepsAdminCount()
            )
            || isSelfLeave()
          );
        allow delete: if false;
      }

      match /roles/{roleId} {
        allow read: if isActivePandalMember();
        allow create: if canManageMembers();
        allow update: if canManageMembers();
        allow delete: if canManageMembers() && resource.data.type != 'builtin';
      }

      match /memberAudits/{auditId} {
        allow read: if canReadAuditOf(pandalId);
        // KAN-34: a member may record their own leave. Everything else stays
        // admin-only so a committee member cannot forge role or join history.
        allow create: if canManageMembers()
          || (
            signedIn()
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.targetUserId == request.auth.uid
            && request.resource.data.action == 'left'
          );
        allow update, delete: if false;
      }

      match /permanentFund/{docId} {
        allow read: if isActivePandalMember();
        allow create, update: if canWritePermanentFund() && pandalNotArchived();
        allow delete: if false;
      }

      match /permanentFundTransactions/{txId} {
        allow read: if isActivePandalMember();
        allow create: if canWritePermanentFund() && ganeshIdentityCreate() && pandalNotArchived();
        allow update, delete: if false;
      }

      match /assets/{assetId} {
        function isDisposeOnlyUpdate() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'disposeReason', 'updatedBy', 'updatedAt']);
        }

        function hasRelatedExpenseLink() {
          return request.resource.data.keys().hasAll(['relatedExpenseId'])
            && request.resource.data.relatedExpenseId is string
            && request.resource.data.relatedExpenseId.size() > 0;
        }

        function linkedExpenseExistsAfter() {
          return !hasRelatedExpenseLink() || (
            request.resource.data.keys().hasAll(['relatedExpenseFestivalId'])
            && request.resource.data.relatedExpenseFestivalId is string
            && request.resource.data.relatedExpenseFestivalId.size() > 0
            && existsAfter(/databases/$(database)/documents/pandals/$(pandalId)/festivals/$(request.resource.data.relatedExpenseFestivalId)/expenses/$(request.resource.data.relatedExpenseId))
          );
        }

        allow read: if canReadAssetOf(pandalId);
        allow create: if canCreateAssetOf(pandalId)
          && ganeshIdentityCreate()
          && linkedExpenseExistsAfter();
        allow update: if ganeshIdentityUpdate() && (
          canUpdateAssetOf(pandalId)
          || (canDisposeAssetOf(pandalId) && isDisposeOnlyUpdate())
        );
        allow delete: if false;
      }

      match /assetAudits/{auditId} {
        allow read: if canReadAssetOf(pandalId) || hasPermOf(pandalId, 'audit.read');
        allow create: if canWriteAssetOf(pandalId) && pandalNotArchived();
        allow update, delete: if false;
      }

      match /sponsors/{sponsorId} {
        allow read: if canReadSponsorOf(pandalId);
        allow create: if canCreateSponsorOf(pandalId) && ganeshIdentityCreate() && pandalNotArchived();
        allow update: if canUpdateSponsorOf(pandalId) && ganeshIdentityUpdate() && pandalNotArchived();
        allow delete: if false;
      }

      match /sponsorAudits/{auditId} {
        allow read: if canReadSponsorOf(pandalId) || hasPermOf(pandalId, 'audit.read');
        allow create: if canWriteSponsorOf(pandalId) && pandalNotArchived();
        allow update, delete: if false;
      }

      match /festivalYears/{year} {
        allow read: if isActivePandalMember();
        allow create: if canCreateFestival()
          && request.resource.data.festivalId is string
          && request.resource.data.year is int
          && string(request.resource.data.year) == year
          && exists(/databases/$(database)/documents/pandals/$(pandalId)/festivals/$(request.resource.data.festivalId));
        allow update, delete: if false;
      }

      match /festivals/{festivalId} {
        function festivalData() {
          return get(/databases/$(database)/documents/pandals/$(pandalId)/festivals/$(festivalId)).data;
        }
        function festivalOpen() {
          return festivalData().status == 'open';
        }

        // KAN-9: path nesting already scopes data. If a write also carries
        // redundant pandalId / festivalId, they must agree with the path so
        // those fields cannot become a forge vector later.
        function scopeIdsMatch() {
          return (
            !request.resource.data.keys().hasAny(['pandalId'])
            || request.resource.data.pandalId == pandalId
          ) && (
            !request.resource.data.keys().hasAny(['festivalId'])
            || request.resource.data.festivalId == festivalId
          );
        }

        allow read: if isActivePandalMember();
        allow create: if canCreateFestival() && ganeshIdentityCreate() && pandalNotArchived() && scopeIdsMatch();
        // KAN-35: the festival document is the lock, not only the UI. Metadata
        // (name, dates, targets) may change while open. Status may only move
        // through the close/reopen shapes that closeFestival/reopenFestival write.
        // Year, id and createdBy cannot move — year uniqueness lives on
        // festivalYears/{year}, which is append-only.
        function festivalYearUnchanged() {
          return request.resource.data.year == resource.data.year;
        }
        function festivalMetadataUpdate() {
          return resource.data.status == 'open'
            && request.resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'startDate', 'endDate', 'contributionMode', 'contributionTargetAmount', 'householdTargetAmount', 'updatedBy', 'updatedAt']);
        }
        function festivalCloseUpdate() {
          return resource.data.status == 'open'
            && request.resource.data.status == 'closed'
            && request.resource.data.closedBy == request.auth.uid
            && request.resource.data.closedAt is timestamp
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'closedAt', 'closedBy', 'updatedBy', 'updatedAt']);
        }
        function festivalReopenUpdate() {
          return resource.data.status == 'closed'
            && request.resource.data.status == 'open'
            && !request.resource.data.keys().hasAny(['closedAt', 'closedBy'])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'closedAt', 'closedBy', 'updatedBy', 'updatedAt']);
        }
        allow update: if canCloseOrUpdateFestival()
          && request.resource.data.updatedBy == request.auth.uid
          && scopeIdsMatch()
          && festivalYearUnchanged()
          && (festivalMetadataUpdate() || festivalCloseUpdate() || festivalReopenUpdate());
        // No hard delete (GS-083), for the same reason the pandal document
        // refuses one (GS-017): Firestore does not cascade, so this would leave
        // every collection, expense, contribution and the festival's summary
        // alive but unreachable — and the rules that reach them call
        // `pandalData()`, so they would start denying too. Close the festival
        // instead; that is what the settlement flow is for.
        allow delete: if false;

        match /fundTransfers/{docId} {
          allow read: if isActivePandalMember();
          allow create: if canWritePermanentFund() && ganeshIdentityCreate();
          allow update, delete: if false;
        }

        match /auditLogs/{auditId} {
          allow read: if canReadAuditOf(pandalId);
        }

        match /{subcol}/{docId} {
          function canWriteFestivalSubcol() {
            return pandalNotArchived()
              && ((subcol == 'collections' && canWriteCollection())
              || (subcol == 'households' && canWriteCollection())
              || ((subcol == 'expenses' || subcol == 'contributions')
                  && canWriteExpenseOrContribution())
              || (subcol == 'reimbursements' && canWriteReimbursement())
              || (subcol == 'openingFunds' && canCreateOpeningFund())
              || (subcol == 'fundTransfers' && canWritePermanentFund())
              || (subcol == 'members'
                  && (canWriteExpenseOrContribution()
                      || canManageMembers()
                      || canCloseOrUpdateFestival()))
              // canCreateFestival() is included so the seed batch that follows a
              // festival create can write its categories and summary. Without it
              // a role holding only festival.create produced a festival with
              // neither (GS-016).
              || (subcol == 'categories'
                  && (canCloseOrUpdateFestival() || canCreateFestival()))
              || ((subcol == 'activity' || subcol == 'auditLogs' || subcol == 'summary')
                  && (canWriteLedgerSideEffect() || canCreateFestival()))
              || (subcol == 'sponsorships' && canWriteSponsorOf(pandalId))
              // GS-076: a collector runs their own session.
              || (subcol == 'collectionSessions' && canWriteSessionOf(pandalId))
              // GS-075: counting is a separate authority from collecting, and
              // adjustments are the only way to touch a settled discrepancy.
              || (subcol == 'reconciliations' && canCountCashOf(pandalId))
              || (subcol == 'cashAdjustments' && canResolveReconciliationOf(pandalId))
              // Seva is the operational schedule, not a ledger. Planning and
              // staffing are separate permissions; neither can touch money.
              || (subcol == 'seva' && canWriteSevaOf(pandalId)));
          }

          // Nested matches OR together, so the explicit
          // `fundTransfers: allow update, delete: if false` above cannot
          // subtract a grant this wildcard makes. The exclusion has to live
          // here. Both collections are append-only evidence.
          function isAppendOnlyLog() {
            return subcol == 'fundTransfers' || subcol == 'auditLogs';
          }

          // ₹100 crore. Far above any real pandal figure, but it rejects the
          // overflow-shaped values (1e300) that poison every downstream sum.
          function moneyCeiling() {
            return 1000000000;
          }

          function okMoney(d, key) {
            return !d.keys().hasAny([key])
              || (d[key] is number && d[key] >= 0 && d[key] <= moneyCeiling());
          }

          // Derived per-member counters are maintained by increment() and can
          // drift below zero (GS-009 does exactly that). They carry no
          // display-integrity role, so bound the type and magnitude but do not
          // assert a floor that would wedge an already-drifted member document.
          function okSignedMoney(d, key) {
            return !d.keys().hasAny([key])
              || (
                d[key] is number
                && d[key] >= -moneyCeiling()
                && d[key] <= moneyCeiling()
              );
          }

          // `date` was validated as `is string` only, so "banana" or
          // "9999-99-99" were accepted and every report that groups or sorts by
          // date inherited the garbage (GS-041). Month and day ranges are in the
          // pattern; Feb 30 still passes, which is the right depth for a rules
          // check — the client owns calendar correctness, this owns the shape.
          //
          // matches() is a full-string match in Firestore rules, so the anchors
          // are belt-and-braces rather than load-bearing.
          function okDate(d, key) {
            return !d.keys().hasAny([key])
              || (
                d[key] is string
                && d[key].matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
              );
          }

          // Drives which Cash/UPI/Bank bucket money moves between, so a junk
          // value silently lands in `other` (resolveFundLocation's default).
          // Harmless today by design, but the buckets are load-bearing since
          // the God Fund location work, so pin the vocabulary.
          function okPaymentMethod(d) {
            return !d.keys().hasAny(['paymentMethod'])
              || d.paymentMethod in ['cash', 'upi', 'bank', 'other'];
          }

          function datesWellFormed() {
            let d = request.resource.data;
            return okDate(d, 'date')
              && okDate(d, 'expectedDate')
              && okDate(d, 'followUpAt')
              && okPaymentMethod(d);
          }

          function amountsWellFormed() {
            let d = request.resource.data;
            return okMoney(d, 'amount')
              && okMoney(d, 'totalAmount')
              && okMoney(d, 'godFundAmount')
              && okMoney(d, 'personalAmount')
              && okMoney(d, 'sponsoredAmount')
              && okMoney(d, 'estimatedValue')
              && okMoney(d, 'expectedAmount')
              && okMoney(d, 'collectedAmount')
              && okMoney(d, 'promisedAmount')
              && okMoney(d, 'contributionTarget')
              && okSignedMoney(d, 'contributionPaid')
              && okSignedMoney(d, 'personalExpenses')
              && okSignedMoney(d, 'reimbursed')
              && okSignedMoney(d, 'pendingReimbursement');
          }

          function statusWellFormed() {
            let d = request.resource.data;
            return !d.keys().hasAny(['status'])
              || (
                subcol == 'contributions'
                  ? d.status in ['promised', 'received', 'cancelled']
                  : subcol == 'sponsorships'
                    ? d.status in ['prospective', 'promised', 'confirmed', 'received', 'cancelled']
                    : subcol == 'households'
                      ? d.status in ['pending', 'visited', 'promised', 'partial', 'paid', 'not_interested', 'not_available']
                    : subcol == 'seva'
                        ? d.status in ['scheduled', 'in_progress', 'completed', 'cancelled']
                        : subcol == 'reimbursements'
                          ? d.status in ['paid', 'voided']
                        : d.status is string
              );
          }

          // A seva must never carry money. Without this a writer holding only
          // seva.write could park an `amount` on a seva document; nothing reads
          // it today, but a later summary or report that did would be spending
          // money authorised by the wrong permission.
          function sevaCarriesNoMoney() {
            return subcol != 'seva' || !request.resource.data.keys().hasAny([
              'amount', 'totalAmount', 'godFundAmount', 'personalAmount',
              'sponsoredAmount', 'estimatedValue', 'ledgerType'
            ]);
          }

          /**
           * Money purpose is a controlled enum (GS-078).
           *
           * Validated so a client cannot invent a category and quietly land its
           * spending outside every report grouping. Only shape is checked here,
           * not which category suits which type — that would be a matrix of
           * comparisons on a rule already at its evaluation ceiling, and the
           * service resolves the pairing from the category document anyway.
           */
          function purposeWellFormed() {
            return (
              !request.resource.data.keys().hasAny(['purposeType'])
              || request.resource.data.purposeType in [
                'collection', 'contribution', 'expense', 'reimbursement',
                'fund_transfer', 'cash_handover', 'adjustment'
              ]
            ) && (
              !request.resource.data.keys().hasAny(['purposeCategory'])
              || request.resource.data.purposeCategory in [
                'household', 'street', 'other',
                'cash_donation', 'sponsor', 'in_kind',
                'pandal_setup', 'decoration', 'electrical', 'sound', 'lighting',
                'idol_religious', 'flowers_pooja', 'food_prasadam', 'water',
                'transportation', 'printing_publicity', 'cleaning', 'security',
                'volunteer_support', 'government_fees', 'vendor_payment',
                'visarjan', 'cultural_programs', 'other_festival_expense',
                'volunteer', 'admin',
                'personal_to_fund', 'fund_to_personal',
                'festival_to_permanent', 'permanent_to_festival', 'other_authorized',
                'collector_to_treasurer', 'treasurer_to_bank',
                'treasurer_to_custodian',
                'correction', 'reconciliation_discrepancy', 'refund', 'reversal'
              ]
            );
          }

          function flagsWellFormed() {
            let d = request.resource.data;
            return (!d.keys().hasAny(['voided']) || d.voided is bool)
              && (!d.keys().hasAny(['archived']) || d.archived is bool)
              && (!d.keys().hasAny(['contributionReference']) || (d.contributionReference is string && d.contributionReference.size() > 0))
              && (!d.keys().hasAny(['reimbursementRequired']) || d.reimbursementRequired is bool)
              && (!d.keys().hasAny(['clientOpId']) || (d.clientOpId is string && d.clientOpId.size() > 0))
              && (!d.keys().hasAny(['date']) || d.date is string)
              && (!d.keys().hasAny(['paymentMethod'])
                  || d.paymentMethod in ['cash', 'upi', 'bank', 'other'])
              && (!d.keys().hasAny(['location'])
                  || d.location in ['cash', 'upi', 'bank', 'other'])
              && (!d.keys().hasAny(['direction'])
                  || subcol != 'fundTransfers'
                  || d.direction in ['to_permanent', 'from_permanent']);
          }

          function contributionWellFormed() {
            let d = request.resource.data;
            return subcol != 'contributions' || (
              d.keys().hasAll(['kind'])
              && d.kind in ['money', 'item', 'service', 'sponsorship']
              && (!d.keys().hasAny(['isCommitteeContribution']) || d.isCommitteeContribution is bool)
              && (d.kind == 'money'
                  || !d.keys().hasAny(['paymentMethod']))
              && (d.kind != 'money'
                  || d.keys().hasAll(['amount'])
                  && d.amount > 0)
            );
          }

          function committeeWaiverWellFormed() {
            let d = request.resource.data;
            return subcol != 'members' || (
              (!d.keys().hasAny(['contributionWaived']) || d.contributionWaived is bool)
              && (!d.keys().hasAny(['waivedBy']) || d.waivedBy is string)
              && (!d.keys().hasAny(['waiveReason']) || d.waiveReason is string)
            );
          }

          /**
           * The summary document is the sole input to availableGodFund() and
           * therefore to every displayed balance, the God Fund spend guard and
           * the settlement figure. Until GS-004 was closed it was maintained by
           * client `increment()` writes, and the rules could only check that the
           * numbers were well-shaped — so a member who could write a ledger
           * side-effect could write a *plausible* wrong number and nothing could
           * tell the difference.
           *
           * The twenty-two derived fields are now written only by the trusted
           * backend (`functions/src/summary.ts`), which recomputes them from the
           * ledger and bypasses these rules. So the client allowlist is reduced
           * to what a client legitimately still owns:
           *
           *   - `nextReceiptNumber` / `nextContributionNumber` — monotonic
           *     allocators handed out in a client transaction. They are not
           *     derivable from the ledger and must never be reset (GS-077), so
           *     the backend never writes them and the rule only checks that they
           *     advance.
           *   - `updatedAt` — written alongside either allocator.
           *
           * Everything else is refused outright. Note this rule is now far
           * *cheaper* than the twenty-five-field version it replaces, which
           * matters: the festival-subcollection wildcard was measured at the
           * 1000-expression ceiling, and that measurement is why the field
           * allowlist GS-004 originally asked for could not be built here.
           */
          function allocatorsOnlyAdvance() {
            let d = request.resource.data;
            return (
                !d.keys().hasAny(['nextReceiptNumber'])
                || resource == null
                || d.nextReceiptNumber >= (
                     resource.data.keys().hasAny(['nextReceiptNumber'])
                       ? resource.data.nextReceiptNumber
                       : 0
                   )
              ) && (
                !d.keys().hasAny(['nextContributionNumber'])
                || resource == null
                || d.nextContributionNumber >= (
                     resource.data.keys().hasAny(['nextContributionNumber'])
                       ? resource.data.nextContributionNumber
                       : 0
                   )
              );
          }

          /**
           * Note this is a *diff*, not `request.resource.data.keys().hasOnly()`.
           * On an update `request.resource.data` is the whole document as it
           * will be after the write, merge or not — so a key allowlist over it
           * would refuse every allocator bump the moment the backend had
           * written the derived fields. What the client is actually restricted
           * from is *changing* them.
           */
          function summaryClientKeysAllowed() {
            let allowed = ['nextReceiptNumber', 'nextContributionNumber', 'updatedAt'];
            return resource == null
              ? request.resource.data.keys().hasOnly(allowed)
              : request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
          }

          function summaryWellFormed() {
            let d = request.resource.data;
            return subcol != 'summary' || (
              summaryClientKeysAllowed()
              && okMoney(d, 'nextReceiptNumber')
              && okMoney(d, 'nextContributionNumber')
              && allocatorsOnlyAdvance()
            );
          }

          // Cash-handling attribution is the primary accountability control in a
          // chanda ledger, and the rules validated nothing (GS-086), so a
          // crafted client could name a fabricated id or a non-member.
          //
          // `exists` only, deliberately: one document read rather than the two
          // an active-status check would cost, and this wildcard already spends
          // several against the per-evaluation budget. The service layer
          // (`resolveCollectorId`) is what enforces *active* membership, and it
          // falls back to the actor rather than failing. This is the floor
          // beneath it, not a replacement for it.
          function collectorIsMember() {
            return !request.resource.data.keys().hasAny(['collectorId'])
              || exists(
                   /databases/$(database)/documents/pandals/$(pandalId)/members/$(request.resource.data.collectorId)
                 );
          }

          /**
           * The summary document's own write predicate (GS-004, found by the
           * emulator suite in GS-074).
           *
           * Firestore caps one rule evaluation at 1000 expressions and returns
           * PERMISSION_DENIED when a rule exceeds it — indistinguishable from a
           * real authorization failure. Routing `summary` through the full
           * festival-subcollection wildcard walked ~10 branches of
           * canWriteFestivalSubcol(), all nine sub-predicates of
           * payloadWellFormed(), and four *Allowed() predicates that cannot
           * apply to a summary at all. On a member whose document predates the
           * denormalized `permissions` array — where every permission check
           * takes its expensive role-document fallback — that ran out of
           * budget, so a legacy treasurer or collector could not bump the
           * totals. `bumpSummary` writes the summary in the same batch as the
           * ledger row and batches are atomic, so the whole money write failed.
           *
           * Evaluated through a ternary below so it genuinely short-circuits:
           * only these three checks run for a summary write.
           */
          /**
           * Subcollections with their own short-circuited rules below.
           *
           * The shared festival wildcard is at Firestore's ceiling of 1000
           * expressions per evaluation — that is what GS-104 was, and the
           * emulator hit it again the moment reconciliation predicates were
           * added to it. Anything money-shaped and new therefore gets its own
           * rule evaluating only what applies to it, rather than a fourteenth
           * branch of `canWriteFestivalSubcol()` plus nine sub-predicates of
           * `payloadWellFormed()` that cannot apply.
           */
          function hasDedicatedRule() {
            return subcol == 'summary'
              || subcol == 'collectionSessions'
              || subcol == 'reconciliations'
              || subcol == 'cashAdjustments'
              || isTokenLadduSubcol()
              || subcol == 'prasadamEntries';
          }

          // KAN-125. Five new subcollections, all short-circuited away from the
          // wildcard for the reason documented above `summaryWriteAllowed()`:
          // the wildcard walks every branch of canWriteFestivalSubcol() and all
          // nine sub-predicates of payloadWellFormed(), none of which can apply
          // to a token, and the evaluation budget is already tight enough that
          // a legacy member's role-document fallback pushed it over once.
          function isTokenLadduSubcol() {
            return subcol == 'tokenLadduConfig'
              || subcol == 'tokenLadduRegistrations'
              || subcol == 'tokenLadduTokens'
              || subcol == 'tokenDrawSessions'
              || subcol == 'tokenDrawResults';
          }

          /**
           * Capacity is the integrity boundary of this feature, so the rules
           * hold the parts of it that do not need a second read.
           *
           * `nextTokenNumber` and `registeredCount` may only advance — a client
           * that could wind either backwards could re-issue a token code that
           * has already been announced, or make room past a full pot. The
           * capacity-versus-registered comparison itself lives in the service
           * transaction, which is the only place that can read both under a
           * lock; this is the floor beneath it, not a replacement.
           */
          function tokenConfigAllocatorsOnlyAdvance() {
            let d = request.resource.data;
            return (
                !d.keys().hasAny(['nextTokenNumber'])
                || resource == null
                || d.nextTokenNumber >= (
                     resource.data.keys().hasAny(['nextTokenNumber'])
                       ? resource.data.nextTokenNumber
                       : 0
                   )
              ) && (
                !d.keys().hasAny(['registeredCount'])
                || resource == null
                || d.registeredCount >= (
                     resource.data.keys().hasAny(['registeredCount'])
                       ? resource.data.registeredCount
                       : 0
                   )
              );
          }

          /**
           * Setting capacity and registering are different authorities, but a
           * registration has to bump the allocator on this same document — so
           * either permission may write it, and the allocator guard above is
           * what stops a token writer editing capacity downward into an
           * inconsistent state.
           */
          function tokenConfigWriteAllowed() {
            return pandalNotArchived()
              && (canConfigureTokensOf(pandalId) || canWriteTokensOf(pandalId))
              && tokenConfigAllocatorsOnlyAdvance()
              && request.resource.data.totalTokens is int
              && request.resource.data.totalTokens >= 0
              && request.resource.data.totalTokens <= 1000000;
          }

          function tokenWriteAllowed() {
            return pandalNotArchived() && canWriteTokensOf(pandalId);
          }

          /**
           * KAN-126. A prasadam entry must never carry money.
           *
           * This is the guarantee behind the feature's accounting position.
           * The register deliberately holds no amount, so it can never be
           * double-counted against a ledger row recording the same rupees -
           * and that is enforced here rather than trusted to a comment in
           * the type file, because a client holding `prasadam.write` could
           * otherwise park an `estimatedValue` on an entry that a later
           * report would happily add up.
           */
          function prasadamCarriesNoMoney() {
            return !request.resource.data.keys().hasAny([
              'amount', 'totalAmount', 'godFundAmount', 'personalAmount',
              'sponsoredAmount', 'estimatedValue', 'ledgerType',
              'purposeType', 'purposeCategory'
            ]);
          }

          function prasadamWellFormed() {
            let d = request.resource.data;
            return d.session in ['morning', 'evening']
              && d.status in ['recorded', 'cancelled']
              && d.date is string
              && d.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
              && d.providerName is string
              && d.providerName.size() > 0
              && d.providerName.size() <= 80
              && d.quantity is number
              && d.quantity > 0
              && d.quantity <= 100000
              && d.unit in ['kg','grams','litres','pieces','packets','plates','boxes','other']
              && d.prasadamType in ['sweet','savoury','fruit','meal','drink','laddu','other']
              && prasadamCarriesNoMoney();
          }

          // An entry cannot be born cancelled: a reversal must be a
          // transition out of a recorded state, so the audit trail always
          // shows what was reversed. Same lesson as
          // contributionNotBornCancelled().
          function prasadamCreateAllowed() {
            return pandalNotArchived()
              && canWritePrasadamOf(pandalId)
              && prasadamWellFormed()
              && request.resource.data.status == 'recorded';
          }

          function drawSessionWriteAllowed() {
            return pandalNotArchived() && canRunDrawOf(pandalId);
          }

          /** GS-076: a collector runs their own session. */
          function sessionWriteAllowed() {
            return pandalNotArchived() && canWriteSessionOf(pandalId) && purposeWellFormed();
          }

          /** GS-075: a count is created unapproved, and never by the collector. */
          function reconciliationCreateAllowed() {
            return pandalNotArchived()
              && canCountCashOf(pandalId)
              && request.resource.data.collectorId != request.auth.uid
              && request.resource.data.status == 'counted'
              && request.resource.data.locked == false;
          }

          /** GS-075 point 8: adjustments are append-only evidence. */
          function cashAdjustmentCreateAllowed() {
            return pandalNotArchived()
              && canResolveReconciliationOf(pandalId)
              && purposeWellFormed();
          }

          function summaryWriteAllowed() {
            return pandalNotArchived()
              && summaryWellFormed()
              && (canWriteLedgerSideEffect() || canCreateFestival());
          }

          function payloadWellFormed() {
            return purposeWellFormed()
              && collectorIsMember()
              && amountsWellFormed()
              && datesWellFormed()
              && statusWellFormed()
              && flagsWellFormed()
              && contributionWellFormed()
              && committeeWaiverWellFormed()
              && summaryWellFormed()
              && sevaCarriesNoMoney();
          }

          function hasNonEmptyAssetId() {
            return request.resource.data.keys().hasAll(['assetId'])
              && request.resource.data.assetId is string
              && request.resource.data.assetId.size() > 0;
          }

          function isAssetPurchaseCreate() {
            return request.resource.data.keys().hasAll(['expenseType'])
              && request.resource.data.expenseType == 'asset_purchase';
          }

          function expenseCreateAllowed() {
            return subcol != 'expenses' || (
              isAssetPurchaseCreate()
                ? (
                    canCreateAssetOf(pandalId)
                    && hasNonEmptyAssetId()
                    && existsAfter(/databases/$(database)/documents/pandals/$(pandalId)/assets/$(request.resource.data.assetId))
                  )
                : !hasNonEmptyAssetId()
            );
          }

          function contributionStatusChanged() {
            return subcol == 'contributions'
              && resource.data.status != request.resource.data.status;
          }

          function contributionUpdateAllowed() {
            return subcol != 'contributions' || (
              !contributionStatusChanged()
              || (
                festivalOpen()
                && resource.data.status == 'promised'
                && (
                  (request.resource.data.status == 'received'
                    && canReceiveContributionOf(pandalId))
                  || (request.resource.data.status == 'cancelled'
                    && canCancelContributionOf(pandalId))
                )
              )
            );
          }

          function sponsorshipStatusChanged() {
            return subcol == 'sponsorships'
              && resource.data.status != request.resource.data.status;
          }

          // The status-transition rules below are only reachable on `update`, so
          // without this a member without `contributions.receive` could skip the
          // permission entirely by setting the final state at creation time and
          // minting received cash (GS-037). Mirrors sponsorshipCreateAllowed().
          // A contribution cannot be born cancelled (GS-089). Cancelling is a
          // transition — `cancelContribution` updates an existing row — so the
          // only reason a create carried this status was the stale option in
          // add-contribution.tsx. Enforced here as well as removed from the UI,
          // because the report's "Cancelled" figure is read aloud to donors.
          function contributionNotBornCancelled() {
            return subcol != 'contributions'
              || !request.resource.data.keys().hasAll(['status'])
              || request.resource.data.status != 'cancelled';
          }

          function contributionCreateAllowed() {
            return subcol != 'contributions' || (
              !request.resource.data.keys().hasAll(['status'])
              || request.resource.data.status != 'received'
              || canReceiveContributionOf(pandalId)
              // Receiving a sponsorship mirrors it into the contributions ledger
              // as a received row carrying `sponsorshipId`. That row is
              // authorized by sponsors.receive, which the actor already had to
              // hold to receive the sponsorship itself.
              || (
                request.resource.data.keys().hasAll(['sponsorshipId'])
                && canReceiveSponsorOf(pandalId)
              )
            );
          }

          function sponsorshipCreateAllowed() {
            return subcol != 'sponsorships' || (
              !request.resource.data.keys().hasAll(['status'])
              || request.resource.data.status != 'received'
              || canReceiveSponsorOf(pandalId)
            );
          }

          function sponsorshipUpdateAllowed() {
            return subcol != 'sponsorships' || (
              !sponsorshipStatusChanged()
              || (
                festivalOpen()
                && (
                  (resource.data.status == 'prospective'
                    && request.resource.data.status == 'promised'
                    && canUpdateSponsorOf(pandalId))
                  || (resource.data.status == 'promised'
                    && request.resource.data.status == 'confirmed'
                    && canUpdateSponsorOf(pandalId))
                  || (resource.data.status in ['promised', 'confirmed']
                    && request.resource.data.status == 'received'
                    && canReceiveSponsorOf(pandalId))
                  || (resource.data.status in ['prospective', 'promised', 'confirmed']
                    && request.resource.data.status == 'cancelled'
                    && canCancelSponsorOf(pandalId))
                )
              )
            );
          }

          // Festival auditLogs stay writable as ledger side-effects, but only
          // admin/treasurer may read them. Nested matches OR together, so the
          // wildcard read must exclude this subcollection.
          //
          // Donor-bearing subcollections gate on a read permission (GS-073);
          // everything else stays open to any active member, because it is
          // aggregate or operational rather than personal.
          function canReadSubcol() {
            return subcol != 'auditLogs' && (
              // KAN-125: a token carries the participant's name and mobile, so
              // it is gated like the rest of the donor PII (GS-073) rather than
              // left open to every active member.
              isTokenLadduSubcol()
                ? canReadTokensOf(pandalId)
                :
              // KAN-126: an entry names a devotee and carries their mobile.
              subcol == 'prasadamEntries'
                ? canReadPrasadamOf(pandalId)
                :
              subcol == 'collectionSessions'
                || subcol == 'reconciliations'
                || subcol == 'cashAdjustments'
                ? canReadSessionOf(pandalId)
                :
              subcol == 'collections' || subcol == 'households'
                ? canReadCollectionsOf(pandalId)
                : subcol == 'contributions'
                  ? canReadContributionsOf(pandalId)
                  : isActivePandalMember()
            );
          }

          allow read: if canReadSubcol();

          /**
           * Approving a count (GS-075 step 6, two-person flow).
           *
           * Three people are held apart, and all three by the server rather
           * than by the client: the collector who carried the cash, the counter
           * who produced the figure, and the approver who signs it off. The
           * approver changes no number — only the status, who approved, when,
           * and the lock — so signing off cannot quietly become re-counting.
           */
          function reconciliationApprovalAllowed() {
            return canApproveReconciliationOf(pandalId)
              && resource.data.status == 'counted'
              && resource.data.countedBy != request.auth.uid
              && resource.data.collectorId != request.auth.uid
              && request.resource.data.locked == true
              && request.resource.data.status in ['matched', 'mismatch']
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly([
                     'status', 'reason', 'approvedBy', 'approvedByName',
                     'approvedAt', 'locked', 'updatedBy', 'updatedAt'
                   ]);
          }

          /**
           * Re-counting before anyone has signed off.
           *
           * A miscount found before approval is fixed by counting again, not by
           * an adjustment against a figure nobody ever stood behind. Still
           * never the collector, and it must stay unapproved.
           */
          function reconciliationRecountAllowed() {
            return canCountCashOf(pandalId)
              && resource.data.status == 'counted'
              && resource.data.collectorId != request.auth.uid
              && request.resource.data.status == 'counted'
              && request.resource.data.locked == false;
          }

          /**
           * A reconciliation locks on approval (point 10). After that the only
           * permitted change is mismatch -> resolved, which `resolveReconciliation`
           * makes when it appends an adjustment; the counted and expected
           * figures can never move.
           */
          function reconciliationUpdateAllowed() {
            return (
                resource.data.locked
                  ? (
                    canResolveReconciliationOf(pandalId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'updatedBy', 'updatedAt'])
                    && resource.data.status == 'mismatch'
                    && request.resource.data.status == 'resolved'
                  )
                  : (reconciliationApprovalAllowed() || reconciliationRecountAllowed())
              );
          }


          allow create: if isActivePandalMember()
            && festivalOpen()
            && scopeIdsMatch()
            && (subcol == 'summary'
              ? summaryWriteAllowed()
              : subcol == 'collectionSessions'
              ? sessionWriteAllowed()
              : subcol == 'reconciliations'
              ? reconciliationCreateAllowed()
              : subcol == 'cashAdjustments'
              ? cashAdjustmentCreateAllowed()
              // KAN-125. `tokenDrawResults` is absent from this list on
              // purpose: the trusted draw endpoint is its only writer, so it
              // falls through to the explicit denial below. A client that could
              // create one could announce a winner the draw never picked.
              : subcol == 'tokenLadduConfig'
              ? tokenConfigWriteAllowed()
              : subcol == 'tokenLadduRegistrations' || subcol == 'tokenLadduTokens'
              ? tokenWriteAllowed()
              : subcol == 'tokenDrawSessions'
              ? drawSessionWriteAllowed()
              : subcol == 'tokenDrawResults'
              ? false
              // KAN-126.
              : subcol == 'prasadamEntries'
              ? prasadamCreateAllowed()
              : (
                canWriteFestivalSubcol()
                && payloadWellFormed()
                && expenseCreateAllowed()
                && contributionCreateAllowed()
                && contributionNotBornCancelled()
                && sponsorshipCreateAllowed()
                && (
                  !request.resource.data.keys().hasAny(['createdBy'])
                  || ganeshIdentityCreate()
                )
              ));
          // Same short-circuit as create. `festivalOpen()` is kept for the
          // summary branch so a settled year stays settled (GS-018), and the
          // createdBy identity clause is skipped because summaryWellFormed()'s
          // key allowlist does not admit that field — a summary never carries
          // one.
          allow update: if subcol == 'summary'
            && isActivePandalMember()
            && festivalOpen()
            && scopeIdsMatch()
            && summaryWriteAllowed();
          // GS-076: only the collector or an override-holder closes a session,
          // and the service records who and why. The rules keep it to members
          // who may write sessions at all; the on-behalf audit fields are the
          // service's job because rules cannot know intent.
          allow update: if subcol == 'collectionSessions'
            && isActivePandalMember()
            && festivalOpen()
            && scopeIdsMatch()
            && sessionWriteAllowed();

          // GS-075: approve, or re-count before approval, or resolve after it.
          allow update: if subcol == 'reconciliations'
            && isActivePandalMember()
            && festivalOpen()
            && pandalNotArchived()
            && scopeIdsMatch()
            && reconciliationUpdateAllowed();

          // cashAdjustments: create only. No update rule at all, so there is
          // nothing to get wrong.

          // KAN-125. The config document is written on every registration (the
          // allocator lives on it), so it needs an update rule; the allocator
          // guard inside keeps that write honest.
          allow update: if subcol == 'tokenLadduConfig'
            && isActivePandalMember()
            && festivalOpen()
            && scopeIdsMatch()
            && tokenConfigWriteAllowed();

          /**
           * A token may be cancelled, and nothing else.
           *
           * The winner fields are deliberately outside the allowlist: only the
           * trusted draw endpoint may declare a winner, and it uses the admin
           * SDK, which bypasses rules entirely. So a client cannot crown itself
           * even holding `tokens.write` — and cannot un-crown a token either,
           * which is what stops a committed result being quietly rewritten.
           */
          allow update: if subcol == 'tokenLadduTokens'
            && resource != null
            && isActivePandalMember()
            && festivalOpen()
            && scopeIdsMatch()
            && tokenWriteAllowed()
            && resource.data.status == 'eligible'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'status', 'cancelReason', 'cancelledBy', 'cancelledAt',
                   'updatedBy', 'updatedAt'
                 ]);

          // A registration is cancelled the same way, and its identity fields
          // never move — the token codes it allocated stay attached to it.
          allow update: if subcol == 'tokenLadduRegistrations'
            && resource != null
            && isActivePandalMember()
            && festivalOpen()
            && scopeIdsMatch()
            && tokenWriteAllowed()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'voided', 'voidReason', 'voidedBy', 'voidedAt',
                   'cancelReason', 'notes', 'updatedBy', 'updatedAt'
                 ]);

          // A draw session is opened, then completed or cancelled. `plannedDraws`
          // and `configuredTokens` are the snapshot KAN-125 asks for, so they are
          // not in the allowlist — the terms of a public draw cannot be edited
          // after it starts. `completedDraws` advances only through the trusted
          // endpoint, which bypasses these rules.
          allow update: if subcol == 'tokenDrawSessions'
            && resource != null
            && isActivePandalMember()
            && festivalOpen()
            && scopeIdsMatch()
            && drawSessionWriteAllowed()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'status', 'completedAt', 'completedBy', 'cancelReason',
                   'updatedBy', 'updatedAt'
                 ]);

          /**
           * KAN-126, editing an entry.
           *
           * `date` and `session` are deliberately outside the allowlist. An
           * entry that could move between sessions would make a day's
           * counts irreconcilable against its own history - so relocating
           * one is a cancel and a fresh record, which leaves both halves
           * visible.
           *
           * `status` is outside it too, and that is what keeps the two
           * update paths honest: an edit can never become a cancellation
           * that skipped the narrower permission.
           */
          allow update: if subcol == 'prasadamEntries'
            && resource != null
            && isActivePandalMember()
            && festivalOpen()
            && pandalNotArchived()
            && scopeIdsMatch()
            && canWritePrasadamOf(pandalId)
            && resource.data.status == 'recorded'
            && prasadamWellFormed()
            && ganeshIdentityUpdate()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'providerName', 'providerId', 'providerSource', 'mobile',
                   'prasadamType', 'prasadamLabel', 'quantity', 'unit',
                   'unitLabel', 'notes', 'sevaId', 'updatedBy', 'updatedAt'
                 ]);

          /**
           * KAN-126, cancelling one.
           *
           * Requires `recorded` on the way in, so cancellation is terminal:
           * a cancelled entry can be neither re-cancelled nor edited back
           * to life. Correcting a mistaken cancellation means recording a
           * fresh entry, which keeps the correction in the audit trail
           * instead of rewriting history.
           */
          allow update: if subcol == 'prasadamEntries'
            && resource != null
            && isActivePandalMember()
            && festivalOpen()
            && pandalNotArchived()
            && scopeIdsMatch()
            && canCancelPrasadamOf(pandalId)
            && resource.data.status == 'recorded'
            && request.resource.data.status == 'cancelled'
            && ganeshIdentityUpdate()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'status', 'cancelReason', 'voided', 'voidReason',
                   'voidedBy', 'voidedAt', 'updatedBy', 'updatedAt'
                 ]);

          allow update: if !hasDedicatedRule()
            && isActivePandalMember()
            && !isAppendOnlyLog()
            && scopeIdsMatch()
            && payloadWellFormed()
            // GS-082: this guard was on create only, so an update could add an
            // `assetId` or flip `expenseType` to `asset_purchase` with no
            // sibling asset, breaking the asset-versus-expense split that
            // `assetPurchaseAmount` and the report both rely on.
            && expenseCreateAllowed()
            && (
              (subcol == 'contributions' && contributionStatusChanged() && contributionUpdateAllowed())
              || (subcol == 'sponsorships' && sponsorshipStatusChanged() && sponsorshipUpdateAllowed())
              || (canWriteFestivalSubcol() && contributionUpdateAllowed() && sponsorshipUpdateAllowed())
            )
            && (
              (festivalOpen() && (
                !resource.data.keys().hasAny(['createdBy'])
                || ganeshIdentityUpdate()
              ))
              || (
                // Admin/treasurer may edit a document they did not create, but
                // only while the books are open. Without festivalOpen() here a
                // settled year stayed editable, silently breaking the
                // reconciliation against the amount transferred at close (GS-018).
                festivalOpen()
                && canCloseOrUpdateFestival()
                && !(subcol == 'sponsorships'
                  && sponsorshipStatusChanged()
                  && request.resource.data.status in ['received', 'cancelled'])
              )
            );
          // Voiding is the designed reversal: it is a soft flag, it is audited,
          // and it reverses the summary. A hard delete does none of that and
          // leaves no trace, so no role gets it. Nothing in the app deletes a
          // festival subcollection document — categories are soft-disabled.
          allow delete: if false;

          /**
           * Volunteer duties, two levels below the festival. The wildcard above
           * is single-segment, so this needs its own block.
           *
           * Guarded on `subcol == 'seva'` because the enclosing wildcard would
           * otherwise offer a `duties` subcollection under every festival
           * collection — a writable side-channel hanging off expenses.
           *
           * Unlike every money record, a duty may be deleted: taking a
           * volunteer off an aarti is routine, reverses no balance and leaves
           * nothing to reconcile.
           */
          match /duties/{dutyId} {
            function dutyWellFormed() {
              let d = request.resource.data;
              return (!d.keys().hasAny(['status'])
                  || d.status in ['assigned', 'on_duty', 'completed', 'declined'])
                && (!d.keys().hasAny(['userId']) || d.userId is string)
                && !d.keys().hasAny([
                  'amount', 'totalAmount', 'godFundAmount', 'personalAmount',
                  'sponsoredAmount', 'estimatedValue', 'ledgerType'
                ]);
            }

            allow read: if isActivePandalMember() && subcol == 'seva';
            allow create: if isActivePandalMember()
              && subcol == 'seva'
              && festivalOpen()
              && canAssignSevaOf(pandalId)
              && dutyWellFormed()
              && (
                !request.resource.data.keys().hasAny(['createdBy'])
                || ganeshIdentityCreate()
              );
            allow update: if isActivePandalMember()
              && subcol == 'seva'
              && festivalOpen()
              && dutyWellFormed()
              && (
                canAssignSevaOf(pandalId)
                // A volunteer may report on their own duty — "I am here", "done"
                // — without holding seva.assign, which is the power to staff
                // other people. Restricted to the status field so it cannot be
                // used to reassign the duty to someone else.
                || (
                  resource.data.userId == request.auth.uid
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'updatedBy', 'updatedAt'])
                )
              );
            allow delete: if isActivePandalMember()
              && subcol == 'seva'
              && festivalOpen()
              && canAssignSevaOf(pandalId);
          }
        }
      }
    }

    // Anything not matched above is denied.
  }
}
