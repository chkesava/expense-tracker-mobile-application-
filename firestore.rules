rules_version = '2';

// Reference source of truth for Firestore security. This file is NOT deployed
// by CI — see docs/FIREBASE_RULES_DEPLOY.md for the manual deploy step.
//
// Ownership model: every personal record lives under `users/{uid}/...`, where
// `uid` is the uid the app writes with. Duress mode swaps the app-level uid to
// `<real uid>_duress` (see lib/authHelpers.ts and lib/duressPath.contract.test.ts),
// so an owned path is either the auth uid or that uid with the duress suffix.
// Both resolve to the same signed-in person, so both are allowed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn()
        && (uid == request.auth.uid || uid == request.auth.uid + '_duress');
    }

    // -----------------------------------------------------------------------
    // Personal data — users/{uid}/...
    //
    // Collections currently written by the app:
    //   accountEntries, accountPayments, accounts, accountTransfers,
    //   accountTypes, alerts, borrowingRepayments, borrowings, categories,
    //   categorizationRules, categoryBudgets, expenses, financialGoals, focus,
    //   holdings, incomes, investments, meta, portfolioOrders,
    //   portfolioSettings, portfolioSnapshots, portfolioTransactions,
    //   receivableRepayments, receivables, spaces,
    //   stats, subscriptions, recurringDismissals, trips, watchlist
    //
    // The recursive match keeps a new collection from silently becoming
    // unreadable the moment it ships, while still confining everything to the
    // owning user.
    // -----------------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // -----------------------------------------------------------------------
    // Shared data — readable by the people named on the document.
    // -----------------------------------------------------------------------
    match /vaults/{vaultId} {
      function isVaultMember() {
        return signedIn()
          && (resource.data.ownerId == request.auth.uid
              || request.auth.uid in resource.data.memberIds);
      }

      // Membership/ownership are only ever set by the owner. Without this, any
      // member could rewrite ownerId/memberIds on a plain update and hijack or
      // lock others out of the vault — the app UI never does this, but nothing
      // stopped a direct Firestore write from doing it.
      function keepsOwnershipStable() {
        return request.resource.data.ownerId == resource.data.ownerId
          && (request.resource.data.memberIds == resource.data.memberIds
              || request.auth.uid == resource.data.ownerId);
      }

      allow read, delete: if isVaultMember();
      allow update: if isVaultMember() && keepsOwnershipStable();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      match /expenses/{expenseId} {
        function parentVault() {
          return get(/databases/$(database)/documents/vaults/$(vaultId)).data;
        }

        allow read, write: if signedIn()
          && (parentVault().ownerId == request.auth.uid
              || request.auth.uid in parentVault().memberIds);
      }
    }

    match /splits/{splitId} {
      function isSplitParticipant() {
        return signedIn()
          && (resource.data.createdBy == request.auth.uid
              || request.auth.uid in resource.data.participantIds);
      }

      // Same rationale as vaults above: createdBy/participantIds must stay
      // stable on a plain update so a participant can't add/remove other
      // participants or reassign the split to themselves.
      function keepsParticipantsStable() {
        return request.resource.data.createdBy == resource.data.createdBy
          && (request.resource.data.participantIds == resource.data.participantIds
              || request.auth.uid == resource.data.createdBy);
      }

      allow read, delete: if isSplitParticipant();
      allow update: if isSplitParticipant() && keepsParticipantsStable();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
    }

    // A payment request is deliberately world-readable: it backs the public
    // /payment/:slug link handed to whoever is being asked to pay, and that
    // person is not signed in. Only the creator can write one.
    match /paymentRequests/{requestId} {
      allow read: if true;
      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
    }

    // Public split summary for /split/:slug. Same write pattern as payment
    // requests. Splits themselves stay private — this snapshot has no account
    // ids, user ids, or UPI.
    match /splitPublicShares/{shareId} {
      allow read: if true;
      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
    }

    // Self-service updates filed from the public /split/:slug page by people who
    // are not signed in. This is the only collection in the project that accepts
    // an unauthenticated write, so every clause below is load-bearing.
    //
    // What keeps it bounded with no server and no auth:
    //  * The document id is derived from (shareId, participantKey), so one
    //    person on one split has exactly one claim slot. An anonymous writer
    //    cannot create documents at will -- only fill a slot the organizer
    //    already published in `claimKeys`.
    //  * `create` is the only anonymous write. An existing document makes a
    //    client setDoc an *update*, which is refused, so the lifetime anonymous
    //    write budget per slot is one. The slot is re-armed only when the
    //    organizer applies or dismisses the claim (an owner delete).
    //  * Anonymous delete is refused on purpose: delete-then-create would reset
    //    that budget and make the write volume unbounded again.
    //  * The parent share must still exist, still be open, and still carry
    //    `claimsEnabled` -- the organizer's kill switch. A share with the flag
    //    absent is closed, so shares written before this feature reject claims
    //    until the organizer next touches the split.
    //  * A claim changes nothing. It credits no account and does not alter the
    //    public share. Applying one is an organizer-only write to `splits`.
    //    That review step IS the security model: `personSlug` and `claimKeys`
    //    are already world-readable, so anyone holding the group link can file
    //    a claim as anyone, and no secret could fix that -- a secret stored in
    //    a world-readable document is not a secret.
    //
    // `list` is closed so the collection cannot be enumerated: the public page
    // (from `claimKeys`) and the organizer (from the split's participants) both
    // already know every document id, and read them directly by id.
    match /splitShareClaims/{claimId} {
      function claimFields() {
        return [
          'shareId', 'slug', 'participantKey', 'type',
          'amount', 'status', 'createdAt', 'updatedAt'
        ];
      }

      function sharePath(shareId) {
        return /databases/$(database)/documents/splitPublicShares/$(shareId);
      }

      function isShareOwner() {
        return signedIn()
          && exists(sharePath(resource.data.shareId))
          && get(sharePath(resource.data.shareId)).data.createdBy == request.auth.uid;
      }

      // Once the organizer deletes the split the parent share is gone, so an
      // orphan claim would otherwise be undeletable forever. An orphan is inert
      // (nothing renders it, and `create` needs a live share, so this cannot be
      // used to re-arm a slot), which makes it safe to let anyone clear it.
      function isOrphan() {
        return !exists(sharePath(resource.data.shareId));
      }

      function wellFormed() {
        let d = request.resource.data;
        return d.keys().hasOnly(claimFields())
          && d.keys().hasAll(claimFields())
          && d.shareId is string && d.shareId.size() > 0 && d.shareId.size() <= 64
          && d.slug is string && d.slug.size() >= 6 && d.slug.size() <= 64
          && d.participantKey is string
          && d.participantKey.size() > 0 && d.participantKey.size() <= 64
          && d.type in ['paid', 'optOut']
          && d.amount is number
          && d.amount >= 0
          && d.status == 'pending'
          && d.createdAt is int
          && d.updatedAt is int
          && d.createdAt == d.updatedAt
          && d.createdAt > request.time.toMillis() - 300000
          && d.createdAt < request.time.toMillis() + 300000;
      }

      function matchesLiveShare() {
        let d = request.resource.data;
        let s = get(sharePath(d.shareId)).data;
        return claimId == d.shareId + '__' + d.participantKey
          && s.claimsEnabled == true
          && s.slug == d.slug
          && d.participantKey in s.claimKeys
          && d.amount <= s.claimAmountMax
          && s.status != 'settled'
          && s.status != 'spent';
      }

      allow get: if true;
      allow list: if false;

      allow create: if wellFormed() && matchesLiveShare();
      allow update: if isShareOwner();
      allow delete: if isShareOwner() || isOrphan();
    }

    // App-wide flags (`global`) and the sideloaded APK pointer (`latest_release`).
    // Clients may read both. Only `global` is writable from the app (onboarding
    // currency). `latest_release` is written by the Admin SDK in CI.
    match /system_settings/{docId} {
      allow read: if signedIn();
      allow write: if signedIn() && docId == "global";
    }

    // -----------------------------------------------------------------------
    // Ganesh Seva — shared Pandal / Festival ledger.
    // ACTIVE membership is the only grant. ownerId / memberIds alone are not.
    // Role helpers mirror shared/utils/ganeshPermissions.ts.
    // Admin-only UI is not enough: memberAudits / festival auditLogs reads and
    // category writes are limited to admin (and treasurer where the TS matrix
    // already grants festival.update / audit.read).
    // -----------------------------------------------------------------------
    function ganeshIdentityCreate() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function ganeshIdentityUpdate() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function ganeshMemberDoc(pandalId) {
      return get(/databases/$(database)/documents/pandals/$(pandalId)/members/$(request.auth.uid));
    }

    function isActivePandalMemberOf(pandalId) {
      return signedIn()
        && exists(/databases/$(database)/documents/pandals/$(pandalId)/members/$(request.auth.uid))
        && ganeshMemberDoc(pandalId).data.status == 'active';
    }

    function ganeshRoleOf(pandalId) {
      return ganeshMemberDoc(pandalId).data.role;
    }

    function hasPermissionsField(pandalId) {
      return ganeshMemberDoc(pandalId).data.keys().hasAny(['permissions']);
    }

    function hasPermOf(pandalId, perm) {
      return isActivePandalMemberOf(pandalId) && (
        ganeshRoleOf(pandalId) == 'admin'
        || (
          hasPermissionsField(pandalId)
          && perm in ganeshMemberDoc(pandalId).data.permissions
        )
      );
    }

    function canManageMembersOf(pandalId) {
      return isActivePandalMemberOf(pandalId) && ganeshRoleOf(pandalId) == 'admin';
    }

    function canWriteCollectionOf(pandalId) {
      return hasPermOf(pandalId, 'collections.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer', 'member', 'collector']
        );
    }

    function canWriteExpenseOrContributionOf(pandalId) {
      return hasPermOf(pandalId, 'expenses.create')
        || hasPermOf(pandalId, 'contributions.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer', 'member']
        );
    }

    function canWriteReimbursementOf(pandalId) {
      return hasPermOf(pandalId, 'reimbursements.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canWritePermanentFundOf(pandalId) {
      return hasPermOf(pandalId, 'permanentFund.transfer')
        || hasPermOf(pandalId, 'permanentFund.add')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) == 'admin'
        );
    }

    function canCloseOrUpdateFestivalOf(pandalId) {
      return hasPermOf(pandalId, 'festival.update')
        || hasPermOf(pandalId, 'festival.close')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canCreateFestivalOf(pandalId) {
      return hasPermOf(pandalId, 'festival.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) == 'admin'
        );
    }

    function canCreateOpeningFundOf(pandalId) {
      return hasPermOf(pandalId, 'openingFunds.create')
        || (
          isActivePandalMemberOf(pandalId)
          && !hasPermissionsField(pandalId)
          && ganeshRoleOf(pandalId) in ['admin', 'treasurer']
        );
    }

    function canWriteLedgerSideEffectOf(pandalId) {
      return canWriteCollectionOf(pandalId)
        || canWriteExpenseOrContributionOf(pandalId)
        || canWriteReimbursementOf(pandalId)
        || canCreateOpeningFundOf(pandalId)
        || canWritePermanentFundOf(pandalId)
        || canCloseOrUpdateFestivalOf(pandalId);
    }

    match /pandalInvites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.pandalId is string;
      allow update: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || canManageMembersOf(resource.data.pandalId)
        );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /pandalJoinRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
            || isActivePandalMemberOf(resource.data.pandalId));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if (
          canManageMembersOf(resource.data.pandalId)
          && request.resource.data.pandalId == resource.data.pandalId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status in ['approved', 'rejected']
        ) || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.pandalId == resource.data.pandalId
          && request.resource.data.status == 'pending'
        );
      allow delete: if false;
    }

    match /pandals/{pandalId} {
      function pandalData() {
        return get(/databases/$(database)/documents/pandals/$(pandalId)).data;
      }
      function pandalAfter() {
        return getAfter(/databases/$(database)/documents/pandals/$(pandalId)).data;
      }
      function isActivePandalMember() {
        return isActivePandalMemberOf(pandalId);
      }
      function canManageMembers() {
        return canManageMembersOf(pandalId);
      }
      function canWriteCollection() {
        return canWriteCollectionOf(pandalId);
      }
      function canWriteExpenseOrContribution() {
        return canWriteExpenseOrContributionOf(pandalId);
      }
      function canWriteReimbursement() {
        return canWriteReimbursementOf(pandalId);
      }
      function canWritePermanentFund() {
        return canWritePermanentFundOf(pandalId);
      }
      function canCloseOrUpdateFestival() {
        return canCloseOrUpdateFestivalOf(pandalId);
      }
      function canCreateFestival() {
        return canCreateFestivalOf(pandalId);
      }
      function canCreateOpeningFund() {
        return canCreateOpeningFundOf(pandalId);
      }
      function canWriteLedgerSideEffect() {
        return canWriteLedgerSideEffectOf(pandalId);
      }
      function keepsPandalCore() {
        return request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.code == resource.data.code;
      }
      function currentAdminCount() {
        return pandalData().keys().hasAny(['adminCount']) && pandalData().adminCount is number
          ? pandalData().adminCount
          : 1;
      }

      allow read: if isActivePandalMember();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.adminCount == 1
        && ganeshIdentityCreate();
      allow update: if canManageMembers() && keepsPandalCore();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        function wasActiveAdmin() {
          return resource.data.role == 'admin' && resource.data.status == 'active';
        }
        function willBeActiveAdmin() {
          return request.resource.data.role == 'admin'
            && request.resource.data.status == 'active';
        }
        function keepsAdminCount() {
          return wasActiveAdmin() && !willBeActiveAdmin()
            ? pandalAfter().adminCount == currentAdminCount() - 1
              && pandalAfter().adminCount >= 1
            : !wasActiveAdmin() && willBeActiveAdmin()
              ? pandalAfter().adminCount == currentAdminCount() + 1
              : pandalAfter().adminCount == currentAdminCount();
        }
        function cannotSelfPromoteToAdmin() {
          return !(memberId == request.auth.uid
            && request.resource.data.role == 'admin'
            && resource.data.role != 'admin');
        }

        allow read: if isActivePandalMember() || memberId == request.auth.uid;
        allow create: if signedIn()
          && (
            (
              memberId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.status == 'active'
              && (
                (
                  request.resource.data.role == 'admin'
                  && pandalAfter().ownerId == request.auth.uid
                )
                || (
                  request.resource.data.role == 'member'
                  && pandalAfter().joinMode == 'open'
                )
              )
            )
            || (
              canManageMembers()
              && request.resource.data.role in ['admin', 'treasurer', 'member', 'collector', 'viewer']
            )
          );
        allow update: if canManageMembers()
          && request.resource.data.userId == resource.data.userId
          && cannotSelfPromoteToAdmin()
          && keepsAdminCount();
        allow delete: if false;
      }

      match /roles/{roleId} {
        allow read: if isActivePandalMember();
        allow create: if canManageMembers();
        allow update: if canManageMembers();
        allow delete: if canManageMembers() && resource.data.type != 'builtin';
      }

      match /memberAudits/{auditId} {
        allow read: if canCloseOrUpdateFestival();
        allow create: if canManageMembers();
        allow update, delete: if false;
      }

      match /permanentFund/{docId} {
        allow read: if isActivePandalMember();
        allow create, update: if canWritePermanentFund();
        allow delete: if false;
      }

      match /permanentFundTransactions/{txId} {
        allow read: if isActivePandalMember();
        allow create: if canWritePermanentFund() && ganeshIdentityCreate();
        allow update, delete: if false;
      }

      match /festivals/{festivalId} {
        function festivalData() {
          return get(/databases/$(database)/documents/pandals/$(pandalId)/festivals/$(festivalId)).data;
        }
        function festivalOpen() {
          return festivalData().status == 'open';
        }

        allow read: if isActivePandalMember();
        allow create: if canCreateFestival() && ganeshIdentityCreate();
        allow update: if canCloseOrUpdateFestival()
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if canManageMembers();

        match /fundTransfers/{docId} {
          allow read: if isActivePandalMember();
          allow create: if canWritePermanentFund() && ganeshIdentityCreate();
          allow update, delete: if false;
        }

        match /auditLogs/{auditId} {
          allow read: if canCloseOrUpdateFestival();
        }

        match /{subcol}/{docId} {
          function canWriteFestivalSubcol() {
            return (subcol == 'collections' && canWriteCollection())
              || (subcol == 'households' && canWriteCollection())
              || ((subcol == 'expenses' || subcol == 'contributions')
                  && canWriteExpenseOrContribution())
              || (subcol == 'reimbursements' && canWriteReimbursement())
              || (subcol == 'openingFunds' && canCreateOpeningFund())
              || (subcol == 'fundTransfers' && canWritePermanentFund())
              || (subcol == 'members'
                  && (canWriteExpenseOrContribution()
                      || canManageMembers()
                      || canCloseOrUpdateFestival()))
              || (subcol == 'categories' && canCloseOrUpdateFestival())
              || ((subcol == 'activity' || subcol == 'auditLogs' || subcol == 'summary')
                  && canWriteLedgerSideEffect());
          }

          // Festival auditLogs stay writable as ledger side-effects, but only
          // admin/treasurer may read them. Nested matches OR together, so the
          // wildcard read must exclude this subcollection.
          allow read: if isActivePandalMember() && subcol != 'auditLogs';
          allow create: if isActivePandalMember()
            && festivalOpen()
            && canWriteFestivalSubcol()
            && (
              !request.resource.data.keys().hasAny(['createdBy'])
              || ganeshIdentityCreate()
            );
          allow update: if isActivePandalMember()
            && canWriteFestivalSubcol()
            && (
              (festivalOpen() && (
                !resource.data.keys().hasAny(['createdBy'])
                || ganeshIdentityUpdate()
              ))
              || canCloseOrUpdateFestival()
            );
          allow delete: if canCloseOrUpdateFestival();
        }
      }
    }

    // Anything not matched above is denied.
  }
}
